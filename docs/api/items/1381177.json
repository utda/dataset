{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1381177",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "書名及び巻冊次は題簽(欠損)及び表紙(墨書)による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 書札, 請渡, 酌, 通, 元, 躾, 公武, 嫁, 聞書, 秘, 三, 法",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「當家弓法躾」のほか書名: 三議一統(巻末), 當家弓兵躾之抄(目首下), 當家弓法躾之抄(序首), 三議一統當家弓法集(序中)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書に「此一冊先年關東在国之砌老父貞慶相傳之通以正夲書写畢 ... 慶申八月二日 小笠原兵部太輔秀政」(「書札之次第」上), 「小笠原大膳大夫長時/同右近大夫貞慶/右此一冊雖為秘事任御執心懇記置之候努々諫早不可有他見者也 元和九年三月吉日 小池甚之丞貞成」(「書札之次第」中)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界11行, 内匡廓: 20.4×15.4cm, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「書札之次第」上の巻末に「右之条々雖爲秘事以家本改之令朱筆加傳畢他見他言有間敷者也 水嶋卜也之成/寳永三丙戌祀林鐘上浣改之 水嶋傳左衛門之董」との朱筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「當家弓法躾」上巻末に「水嶌卜也」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引, 朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「清」, 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
