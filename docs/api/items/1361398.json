    "dcterms:description": [
        {
            "@value": "書名及び巻次は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "8の目首の書名: 蛙鈔",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "各奥書に「享和三年仲春一挍畢」(1-2)「享和三季春挍合畢」(3)「享和三年季春挍合畢」(4)「享和三年仲春一挍了」(5)「享和三年孟夏挍合畢」(6-7)「一挍畢」(8)とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "1: 冠部, 剱部. 2: 袍部. 3-4: 下襲部. 5: 半臂, 袙, 表袴部. 6: 直衣部. 7: 打衣部. 8: 車輿部",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「希賢亭圖書記」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "1の扉裏に「經亮云蛙抄ハ三條家ニ秘藏セラレシ装束抄ナリ邂逅ニ袍部及車輿部ノ二冊ハ世ニ流布セリ今又下重部二冊半臂袙表袴部一冊直衣部一冊打衣部一冊以上八冊也此餘モアリトイヘトモイマタ知ラス半臂部ニ其事見小忌部トアルヲ見レハ小忌部ナドモアルベシ而シテ此抄ハ三條家ノモノトモミヘズ當家ト抄中ニアルハ洞院家ノコト也若疑ハ東山左府實凞公ナトノ手ニ出タリシニヤ可考事ナリ先年コノコトヲ瑜伽心院入道前権大納言紀光卿ニキコヱケレバサモアラント諾玉ヘリ」と朱書あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "付箋あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
