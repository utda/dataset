            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾に欠損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱青墨筆書き入れあり",
