    "archiveshub:note": [
        {
            "@value": "大尾の書名: 新薄雪物語",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 繪入新うす雪物語(巻1), ゑ入新薄雪物語(巻4), ゑ入新うす雪物語(巻5)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下に「みやこ賢女鑑」(巻1), 「見屋古賢女鑑」(巻2), 「都賢女鑑」(巻5)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 新うすゆき",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「女筆工 蘭溪筆/繪師 大森善清」, 「正徳六丙申歳正月吉辰/書林 大坂新町西口小濱町河内屋 向井八三郎板行」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界12行, 内匡廓: 21.5×15.4cm, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻5の後見返しに「宇津木政 寛政六秊」(墨筆), 「主月沼倉鹿野氏」(朱筆)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「青洲文庫」(渡辺信), ほか貸本屋印2顆あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "汚損あり",
