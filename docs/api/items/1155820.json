    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "題簽の書名: 琉球徃来",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋に「慶長八年癸卯當大明萬暦三十一年頃琉球国三年在留内依那覇港馬氏高明所請作之岱中□□(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書に「文化六己巳年十二月於京師得之藏 伴信友(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書(朱書)に「天保七丙申年七月十三日課人令謄写加一?畢 長澤伴雄(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊國徳川氏圖書記」,「陽春廬記」,「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり(巻末に「信友按岱中ハ岱中ナルヘシ琉球神道記ヲ作タル人ニテ琉球ヘ行タル人ナリ僧ナリナホ考ヘシ□□トアルハ字ナルカ」と朱書あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付箋あり 虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "28cm",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
