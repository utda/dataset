    "bibo:annotates": [
        {
            "@value": "題簽の書名: 蕉風俳談無縁行辯",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[序]末に「于時寛政辛酉孟春十四日 ... 舟文堂主人述」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[序]末の奥書に「文化三丙寅初穐 玉塊舎写/文化十二乙亥晩春仲浣七日再写」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "附: 案方附方七名八躰, 二十五箇條",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『二十五箇條』の奥書に「于時元文化乙丑神無月朔望写於東海葷刹云云/東都城南漫士 汶水山人書」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「瀧氏藏書」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
