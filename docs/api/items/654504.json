    "dcterms:description": [
        {
            "@value": "Christmas mailing time / Packages for our armed forces overseas must be mailed between Sept. 15–Oct. 15 / Address correctly / Wrap them securely / Weight limit--5 lbs. / Size limit--15 in. long--36 in. length and girth combined / Prepay full postage / Christmas cards must be in sealed envelopes but can be mailed any time / U.S. Army and Navy Postal Services",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "海外で戦っている兵士にとって、クリスマス・プレゼントが期日に届くということは士気高揚の上で非常に大切であった。軍は市民に対し、１０月１５日までにクリスマス・プレゼントを発送するように要請した。Bogoradのサインあり。",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
