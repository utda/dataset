        },
        {
            "@value": "小口書: 雀巣庵草木写生図",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しの貼紙に「此図ハ甚タ錯雜ナリシテ今植学区分ノ順ニ従ヒ以テ一冊トスルノ也原図ハ尾張名古屋本草家吉田雀巣庵主人ノ遺稿ナルヲ十九年五月神波全庵氏ゟ求ムル所也 明治十九年六月廾七日  田芳男記」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "おもに図版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「男爵田中美津男氏寄贈先代田中芳男男旧藏書/昭和七年」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
