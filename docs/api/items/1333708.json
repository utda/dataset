    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "大尾の書名: 名方類證醫書大全",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序首の書名: 新刋名方類證醫書大全",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 醫書全",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "箱題簽の書名: 醫書大全",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「大明天順二年歳在戊寅六月初吉 ... 惠陽吴高尚書」, 「正統十一年歳在丙寅春之初鼇峯熊宗立道軒序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "目尾の原刊記に「成化三年丁亥熊氏種徳堂刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「近世醫書大全自大明来固醫家至寳也所憾其夲稍少欲見而未見者多矣泉南阿佐井野宗瑞捨財刋行彼収本有三冩之謬令就諸家考本方以正斤兩雖一毫髮私不増損盖宗瑞之志不爲利而在救濟天下人偉哉陰徳之報永及子孫矣 大永八年戊子七月吉日 幻雲壽桂誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界13行24字, 内匡廓: 20.8×14.6cm, 中黒口双黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠成化3(1467)熊宗立種徳堂刊本重刊後印",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序首ののどに「天袖加瀬氏本」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「正直」, 「多紀氏藏書印」, 「杉恒簃珍藏記」(杉本恒簃), 「三井家」, 「聼仌壬戌以後所集舊槧古鈔」, 「雙鹿堅藏」, 「大正十一年所得古槧」 (三井高堅)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
