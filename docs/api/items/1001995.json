    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻1-4の巻末書名: 註畫讃",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「天明八年戊申季秋念六日盹挑殘燈写之畢 大田覃」, 「(寛永九年壬申三月中野市右衞門刋行)ト奥書アル板本ハ假名本ナリ此書ノ文ヨリ畧セル所アリ ... 寛政四年壬子五月五日午時把筆 杏花園」とあり (「南畝」, 「杏園」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉9行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆返点, 送り仮名あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱引, 朱点, 朱傍注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「南畝」, 「南畝文庫」, 「大田氏臧書」(大田南畝), 「陽春廬記」(小中村清矩),「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
