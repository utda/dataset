    "archiveshub:note": [
        {
            "@value": "卷首の巻頭書名: 新鐫翰林釐正平仄四書六經小學鑑史難字金鏡",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷首の巻末書名: 經史難字金鏡",
            "is_public": true,
