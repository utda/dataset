    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 曾南豐先生文集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "18-20, 末卷の目首書名: 曾文定公詩集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋の書名: 元豐類稾, 新刻曾南豐先生集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 曾文定公集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名(佐久間象山手筆): 曾南豐先生全集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「康熙壬申仲冬既望後學湯來賁撰」, 「余同年友彭君毅齋重刊南豐曾文定公集成問序於余 ... 康熙三十二年癸酉端陽後一日平干王謙拜題於洪州官舎」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋に「録未刻七篇送毅齋先生補刋集中傳之久遠 ... 康熙丁丑歳閏月八日山陽後學戴晟謹識」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋末の識語に「丁丑客遊淮陰邑侯鄭父母傳示遺文七篇爲山陽戴君晦夫所蒐輯者 ... 期謹識」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界9行20字, 内匡廓: 20.4×12.3cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "圏点あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠康熙31(1692)彭期刊本補刻",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「惠震之書」, 「禄」, 「象山書院」(佐久間象山), 「前島氏」, 「篁村島田氏家藏圖書」, 「島田氏雙桂樓収臧」(島田篁村), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
