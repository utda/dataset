        },
        {
            "@value": "跋中の書名: 三番舩",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "跋に「三番舩者自素所編集書次第之號也首載於發句唱句之佳作次載漢和和漢之秀唫焉 ... 尾補伊呂波韻脱落之文字固高田氏幸佐淺學者也云爾旹元禄著雍攝提格之年林鍾上浣河端己千子昌音謹跋焉」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界6行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
