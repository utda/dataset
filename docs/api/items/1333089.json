            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "乾の見返しに「正徳三年巳十一月八日 安藤辰次郎持主」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
