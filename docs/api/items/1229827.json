    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の巻頭書名: 拾遺和歌集(巻第3), 拾遺和謌集(巻弟4), 拾遺和哥集(巻第12)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥中の書名: 抄哥, 拾遺抄哥, 拾遺抄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書写者表示は蔵書票による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本奥書に「天福元年仲秋中旬以七旬有餘之盲目重以愚夲書之八ヶ月終功為授鐘愛之孫也翌日令讀合畢此集世之所傳無指證夲仍以数多舊夲挍合被是取其要猶非無不審又即合抄之證夲/抄哥五百九十四首 上二百卅五首 下三百五十九首」, 「文應元年七月託或人書写之 ... 以定家卿自筆夲一挍了 桒門融覺判」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書末に「以正本をおよすのみ也/此集花山院ノ御自撰ト云々 ... 又大納言公任重撰是拾遺抄也」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 上, 下",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉11行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
