    "dcterms:description": [
        {
            "@value": "巻次は巻末の貼紙による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "12の奥書に「文化二年冬与正親町入道前大納言校合了 中宮大夫公修」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "4: 永暦元年秋. 5: 永暦元年十一月. 6: 永暦元年十二月. 7: 永暦二年四月. 8: 應保元年秋. [補1]: 應保元年十二月. [補2]: 長寛二年三月六月. 9: 仁安二年二月. 10: 仁安二年三月. 11: 仁安二年四月五月六月. 12: 安元々年秋. 13: 治承二年正月. 14: 治承二年五月六月閏六月. 15: 治承二年十月. 16: 治承二年十一月. 17: 治承三年正月. 19: 治承三年夏奥七月歟. 20: 治承三年冬. 21: 治承四年二月. 22: 治承四年三月. 23: 治承四年四月. 24: 治承四年五月. 25: 治承四年秋. 26: 治承四年冬. 27: 元暦元年七月即位事. 28: 元暦元年八月大嘗會検校事. 29: 元暦元年九月大嘗會検校. 30: 元暦二年元日節會. 31: (元暦二)文治元年七月八月九月. 32: 執筆要",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "[補1-2]: 補配([補1]の奥書に「以山田大学本写之 文化十一年十月中宮大夫藤」とあり)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「三條文庫」,「弎條文庫」,「三條之印」",
