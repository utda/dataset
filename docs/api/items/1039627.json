    "archiveshub:note": [
        {
            "@value": "卷之3-6,23,33-34,52-53,63の巻尾の書名: 全書",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "張獻輝校閲",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "封面に「康熈庚寅年新鐫」「玉詔堂蔵板」とあり(「本堂原板不同翻刻」の朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界9行24字、単魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之1-2: 入集. 卷之3-6: 道集. 卷之7-8: 須集. 卷之9-12: 從集. 卷之13-15: 性集. 卷之16-18: 理集. 卷之19-21: 明集. 卷之22-25: 心集. 卷之26-29: 必集. 卷之30-33: 貫集. 卷之34-37: 天集. 卷之38-39: 人集. 卷之40-42: 謨集. 卷之43-45: 烈集. 卷之46: 聖集. 卷之47: 賢集. 卷之48-49: 大集. 卷之50-51: 徳集. 卷之52-53: 圖集. 卷之54: 書集. 卷之55-57: 宇集. 卷之58-60: 宙集. 卷之61-63: 長集. 卷之64: 春集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「井上藏書」,「竹井氏蔵書記」,「大賀藏書」,「竹苞松茂」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
