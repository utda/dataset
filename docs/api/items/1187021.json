    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は表紙による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しに「此本ハ狩谷棭斎ノ旧藏ニテ外題ハ氏ノ手書ナリ」との朱筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「一本ハ皇太神宮舊袮冝藤波家ニ藏スル古夲ヲ以テコレヲ写ス大凡同家ノ藏書数百卷三四百年前ノ物ニテ寛正ノ奥書アルナト見エレ凡皆神宮ノ古記ナリ其中ニ此一卷アリケレハ書生ヲシテ写サシメツル也 久米幹文/明治九年三月廿三日伊勢林崎ニ於テ識之/右ノ一夲ニ依テ一校了 同十五年六月十七日於東京大学」, 「右ハ此本ヲ久米幹文氏ニ貸タルヲ己レノ本ニ比校シテ返シタル時異同ト奥書トヲカク書加ヘテオコセタルナリ 小中村清矩」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
