    "dcterms:description": [
        {
            "@value": "浜田杏堂:江戸時代後期の医師、画家。福原五岳に南画を学び、山水・花鳥をよく描いた。　(1766－1815),奈須恒徳:江戸時代後期の漢方医。「大同類聚方」など室町時代以前の医書の校訂をおこなった。著作に「本朝医談」など。(1774－1841)",
            "is_public": true,
