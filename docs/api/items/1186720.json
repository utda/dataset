{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1186720",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "大尾の書名: 竒跡考",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 近丗奇跡(卷之1), 近世奇跡考(卷之2), 近丗竒跡考(卷之4), 近卋竒跡考(卷之5)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しに「醒醒老人著 武清先生畫 瑞玉堂蔵版」との刊記あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "凢例末に「文化紀元甲子春三月 江戸醒々齋誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]末に「甲子秋日 可葊源武清誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥付に「文化改元甲子十二月吉日 書林 大坂 心齋橋唐物町 河内屋太助/江戸 大傳馬町ニ丁目 大和田安兵衛梓」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「江戸 山東老店」の広告目録(半丁)あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「奇跡考五卷文化二乙丑年二月十二日故ありて作者板元之門から板を絶しにると友人山東子後にかたれり」と曲亭馬琴による識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之1: 9, 16丁. 卷之2: 15丁. 卷之3: 13丁. 卷之4: 18丁. 卷之5: 18, 2丁",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界11行, 内匡廓: 19.0×13.2cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「曲亭臧本」, 「著作堂圖書記」,  「瀧澤文庫」(曲亭馬琴), 「坂田文庫」(坂田諸遠),  「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
