    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "版心の書名: 旴江文集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名(墨書): 李旴江集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 李旴",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下に「知南城縣事犍為孫甫訂刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墓記末に「成化八年壬辰春三月朔旦立石賜進士及第翰林國史脩撰永豐羅倫撰」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後序末に「遂與邑之文人共加叅訂選諸善書鍥諸梓氏圗永其傳焉工食之需薄俸三之一李氏子孫三之二刋成識此于末 正徳戊寅孟冬上日 賜同進士出身知南城縣事川南孫甫序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[首]: 序, 建昌新建李泰伯祠堂記, 奏詞, 建昌府重修李泰伯先生墓記, 目録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界11行20字, 内匡廓: 16.5×12.1cm, 白口単白魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「舊和歌山徳川氏藏」(徳川頼倫), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
