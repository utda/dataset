    "archiveshub:note": [
        {
            "@value": "その他の巻頭書名: 春色梅こよ美(巻之2), 春色梅兒譽美(巻之4)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻尾の書名: 春色梅ごよ美(巻之1), 春色梅ごよみ(巻之3), 春色梅児誉美(巻の5), 春色梅児与美(巻の11), 春色梅児譽美(巻の12)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序の書名: 梅こよ美([初編]), 春色梅暦([2編]), 梅古与美(3編)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 梅兒譽美([初編]), 梅児譽美(3編), 梅こよ美(第4輯)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "のどの書名: ウメ, うめ, こよみ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[2編]序末に「天保三壬辰年春正月吉旦 江戸書林 永壽堂 西村與八/文永堂 大嶌屋傳右エ門」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "第4輯の口絵に「書房文永堂上梓」, 「天保四癸巳陽春發行之記」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[初編]: 巻之1-3: [2編]: 巻の4-6 . 3編: 7-9之巻. 第4輯: 巻の10-12",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界8行, 内匡廓: 14.5×9.9cm, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
