    "archiveshub:note": [
        {
            "@value": "国文学研究資料館「歴史的典籍NW事業」によるデジタル化",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
    "bibo:annotates": [
        {
            "@value": "書名及び巻冊次は題簽による",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[序]末に「筑前の国飯塚のうま屋なる依兮發起」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥書末に「天明二年寅十月時雨會於義仲寺芭蕉堂前 蝶夢幻阿弥陀佛謹誌」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "天の末に「奉納汶村江刕川瀬之店 野村正光(花押)」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "刊記に「寛政元年己酉春發行/粟津義仲寺藏/皇都書林 井筒屋庄兵衛/橘屋治兵衞/同儀兵衞」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "のどによる巻冊次表示: 上, 下",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "拠義仲寺蔵芭蕉門人真蹟の模刻",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
