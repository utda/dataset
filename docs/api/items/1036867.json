        },
        {
            "@value": "帙題簽の書名: 栄華物語",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名の繰返し部分は踊り字",
            "is_public": true,
