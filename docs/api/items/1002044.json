{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1002044",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名及び巻冊次は各巻目首による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "18末に「一本應永廿四年六月十五日写之」と原奥書の模写あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉に「長胤云此字鏡集二十巻ハ勢州人足代權大夫弘訓ノ藏書ニテ四巻以下表紙ニ狩谷氏惠贈トアリ抑学者タル人珍書ヲ得タル悦此ノ如シ依テ先代相傳ノ書ヲ得テ読者其書ヲ求ムル人ノ労ヲ知ス」, 巻末に「字鏡集二十巻菅原為長卿撰墨附千六枚」, 「一本ハ應永年中之写本を摸写セシ落合直澄氏ノ所藏也」との朱筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "4-20の表紙に「棭齋狩谷氏惠贈」, 「足代權大夫藏」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "1: 天象部. 2-4: 地儀部. 5-7: 植物部. 8-10: 動物部. 11-13: 人躰部. 14: 人事部. 15-17: 雜物部. 18-20: 辞字部",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙は松皮菱毛目(1-3), 横刷毛目丁子引(4-20)を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉4行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「さかきのやのしるし」(常世長胤), 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
