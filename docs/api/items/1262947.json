        },
        {
            "@value": "題簽の書名: 改正付合小かゝみ",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "原刊記に「延寳七己未孟夏吉旦 二條通 野田藤八板行」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥付に「京都書店/竹苞樓 錢屋惣四郎」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界8行注文双行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥付に「安政二年乙夘初秋之頃従延壽王院筑紫太宰府天満宮別当令到来之畢 季知」との墨書あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
