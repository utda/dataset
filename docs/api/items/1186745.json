    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "[跋]中の書名: 真草千文",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名(墨書): 智永禪師真草千文",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]末に「真草千文八百本散於世江東諸寺各施一夲 ... 長安崔氏所蔵真跡最爲殊絶命工刋石置之漕司南廰傳永久大觀己丑二月十一日樂安薛嗣昌記」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽下部に「長松恠石齋蔵」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎帖4行10字",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "折本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠北宋大觀3(1109)跋薛嗣昌模刻拓本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「長枀恠石齋」, 「吉田周印」, 「日子山人」, 「勿謂今日不學而有來日勿謂今秊不學而有来秊日月逝矣歳不我延嗚呼老矣是誰之愆」, 「野向堂」, 「玉巌」(太田玉巌), 「紀伊徳川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
