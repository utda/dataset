    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 雲林神彀",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "目首の書名: 新鍥雲林醫彀",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之2, 4の内題下に「文源堂蔵板」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「萬暦丁酉春月上吉歸安鹿門山人茅坤譔」, 「旹大明萬暦廿五年歳次丁酉春之吉金谿龔廷賢譔」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺有界12行24字, 内匡廓: 19.8×12.4cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之1: 7, 2, 22丁. 卷之2: 33丁. 卷之3: 38丁. 卷之4:  36丁",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠萬暦25(1597)序金陵書林周對峰刊本重刻",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之1の表紙に「萬暦版」, 「橒園手澤」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「杉本氏藏書」, 「森氏」(森養竹), 「吉氏家藏」(吉田意庵)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
