        },
        {
            "@value": "巻第1の表紙に「足利夲」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻第2末に「友信書冩」(青筆)とあり",
