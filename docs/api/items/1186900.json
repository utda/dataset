            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注, 傍注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
