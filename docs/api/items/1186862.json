{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1186862",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "版心の書名: 古今",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "自序末に「建長六年應鐘中旬散木士橘南袁愗課小童猥叙大較而已」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「元禄三年庚午孟春吉祥日/書林 武江 武藤与惣兵衛/同 河﨑七郎兵衛/同 高嶋弥兵衛」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界10行, 内匡廓: 16.4×13.0cm, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "麻の葉繋ぎに松葉菊花丸文様の表紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「慶應四年八月三日以紀伊殿秘庫御本及木村氏藏古本挍合訖」(卷第1)「慶應四とせという年のは月廾日殿の御本と木村正辭の本とを見くらへて夲文をくてし書いれをはりぬ紀の酉人小中村清矩」(卷第20)との朱青筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「閑齋」, 「大石」, 「東洲文庫」, 「やすむろ」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
