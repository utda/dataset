    "bibo:annotates": [
        {
            "@value": "穐之部の巻頭書名: 古人五百題句集",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "目首の書名: 古人五百題",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "見返しの書名: 誹諧故人五百題",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "凡例末に「丁未嵗皐月 松露菴主人」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "原奥付に「天明七丁未年五月開板/天保十己亥年四月再板/文久三癸亥年五月三刻/江戸發行書林 須原屋茂兵衞/山城屋佐兵衞/英屋文藏梓」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻末に「東都書林 下谷御成道 青雲堂英文藏」の出版目録(4丁)を付す",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "左右双辺無界2段12行, 内匡廓: 13.2×8.4cm",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "文久3[1863]江戸須原屋茂兵衞/山城屋佐兵衞/英屋文藏刊の後印",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "冬之部の後見返しに「洲ぬし 吉夲」との墨書あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「笑月」, 「青洲文庫」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
