    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥中の書名: あつま道の記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 下通道ノ記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻冊次は題簽による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下に「天保九年増補」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「天保九年夏先臣淺加久敬撰する所のあつま道の記新冩を命せらるこの原書魯魚之訛おふく文義の通しかたき所数十百条すくなからすよりて聊其あやまりを正し且名所の古哥なと書類浄冩なり之奉りたる」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「坂田文庫」(坂田諸遠), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
