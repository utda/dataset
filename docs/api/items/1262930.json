    "archiveshub:note": [
        {
            "@value": "国文学研究資料館「歴史的典籍NW事業」によるデジタル化",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
    "bibo:annotates": [
        {
            "@value": "題簽の書名: 連歌當流新式うふきぬ(上), 連哥當流新式うふきぬ(中-下)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "内題下に「以呂波仁保遍止」(第1), 「知利奴留乎和加」(第2), 「与太礼曾津祢奈」(第3), 「羅無宇為乃於久」(第4), 「也末計不公江天」(第5), 「安左幾由女美之」(第6), 「恵比毛世寸」(第7)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "刊記に「元禄十一戊寅年六月吉日/浪蕐書林 隅谷源右衛門/柏原清右衛門/鳥飼市兵衛」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 上, 中, 下",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界18行, 内匡廓: 9.2×13.7cm",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
