    "archiveshub:note": [
        {
            "@value": "「上令義解表」末に「天長十年十二月十五日右大臣從二位兼行左近衛大將臣清原真人夏野上表」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 卷第1本: 官位. [卷第1末]: 職員, [後宮], 東宮, [家令]. 卷第2: 神衹, 僧尼, 戸. 卷第3: 田, 賦役, 學. 卷第4: 選叙, 継嗣, 考課, 禄. 卷第5: 宮衞, 軍防. 卷第6: 儀制, 衣服, 営繕. 卷第7: 公式. 卷第8: 厩牧. 卷第9: 假寧, 喪葬, 捕亡. 卷第10: 獄, 雜",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺無界8行18字注文双行, 内匡廓: 21.0×14.5cm, 中黒口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "五つ目綴じ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第10の後見返しに「本云 延寳六戊午十月十二日朱そう 際貞」との朱墨筆奥書あり",
