    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は扉による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉に「十六年九月二日成 田中芳男」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉裏に「此冊明治十二年東海山陽之諸縣ヨリ福岡長崎ノ両縣ニ至ル紀行中植物に関スル件ヲ抄出シ携帰ル腊葉ヲ印シ以テ聊力筑前筑後肥前ノ植物ヲ示シ又長崎ニ於テ織田賢司氏ニ聞キタル説等ヲ併セ載ス 十六年九月二日成 然ルニ尚腊葉一束アリ十七年二月見出ス併セテ墨刷シ缺ヲ補シ増ス三月廾二日」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心上部に「大學南校」, 下部に「農商務省」とある罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「山田」, 「男爵田中美津男氏寄贈先代田中芳男男旧藏書/昭和七年」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
