        {
            "@value": "巻尾の書名: 和劑局方圖經本草",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉の書名: 和劑局方 : 圖經",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 太平和劑圖經本草藥性総論",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "識語: 「大正五年十二月十四日装釘 理学博士 白井礫水藏」,「日華子吉田宗桂先生 宗桂意安ト稱ス能ク倭薬ヲ辨知ス故ニ世人日華子ヲ以テ之ヲ称ス遂ニ自以テ別號ト為ス 後奈良天皇天文八年大明使僧天龍寺策彦ニ伴テ大明ニ赴キ薬ヲ大明皇帝ニ献シ醫名ヲ異域ニ著ス元亀三年十月二十日死ス 菊馨(「醫博士」「岡崎桂印」朱印)」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり(裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
