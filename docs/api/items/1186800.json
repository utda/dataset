    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名(墨書): 日本書紀 : 神代",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名: 日本書紀神代卷",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本奥書に「本云 天文癸巳仲秋中二加修補之已矣 天児屋根尊四十八世孫 神祇管領勾當長上侍従卜部朝臣兼右」, 「本云 累家以秘夲不邁一字并数度挍合了勿許外見 慶長十五庚戌夘月七日 梵舜判」(巻第1), 「写本云 右兩冊者神龗真筆也不可出窓外矣 天文癸巳季秋仲二 侍従卜部兼右」, 「夲云 予重而以累家秘夲不邁一字并数度及挍合遂書功並可為證夲敦不可許外見者也 于時慶長十五庚戌夘月七日 梵舜判」(巻第2)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「神代上下巻依綸命不顧愚蒙姉少路少将公景讀書家傳申畢敢他言御憚殊神慮恐奉専用而已 寛永元甲子嵗十一月七日神龍院梵舜(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉7行13字",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注, 傍注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
