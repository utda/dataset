            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「元禄二年己巳冬日 東都隱士 政友入道八十七翁」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽に「桺亭挍本」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
