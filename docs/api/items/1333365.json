        },
        {
            "@value": "表紙の書名(墨書): 不求橋梨夲隱家勧進百首",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 不求橋勧進百首",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「元禄七甲戌歳九月日 江戸下谷車坂 本屋伊兵衛刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界9行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「杏花園」, 「桃橘園主人」の墨筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「杏園」, 「南畝」, 「南畝文庫」, 「大田氏臧書」(大田南畝), 「歌城」, 「布治波良乃毛等袁宇多岐爾乎佐牟留布美良乃之留思」(小林歌城), 「福田文庫」(福田敬園), 「枀蔭圖書」, 「坂田文庫」(坂田諸遠), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損, 湿損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
