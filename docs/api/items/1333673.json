    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 脣舌圗",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥中の書名: 戴先生唇舌図訣",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「痘瘡之治得戴曼公始詳矣而其禁方祕訣盡傳于池田瑞仙氏今此圖則池田氏之所祕而乃曼公之傳也唇候十八舌候四十一摸之丹青之精緻標之議論之的確髣髴乎如目視 ... 余得此圖于某氏乃摸而藏焉時天保乙未十一月 林守誠識」とあり(落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末の識語に「慶應丁夘小春十日忽獲之于八町渠股董餔真是天賜不堪於喜録其始末如此 華翁森立之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "折本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "貼付け彩色図61幅あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「□樵夫」(林守誠), 「森氏開萬冊府之記」(森立之)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
