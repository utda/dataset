    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "大尾の書名: 新刋本朝文粹",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋の版心書名: 文粹",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序に「本朝文粹十四卷明衡撰其所纂 ... 寛永己巳仲冬下旬 羅山子道春」, 「今也野野村知求有志于學欲刋行之四方謀諸吉田玄之讎校是非 ... 寛永己巳冬十一月日 尾陽醫官法眼杏菴正意書」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋に「有野氏知求者鳩剞劂氏刋本朝文粹七閲月而竣願君一言跋之 ... 寛永己巳夏六月平安後學那波道圜書于武江之僑居」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「于時寛永六己巳暦卯月吉旦 玉屋町 田中長左衞門刋之」(卷第1), 「玉屋町 田中長左衞門開板」(卷第14)とあり(「正重」との版元墨刻印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界9行18字注文双行, 内匡廓: 22.2×16.8cm, 中黒口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後印本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
