    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書名は表紙による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "本奥書に「康和元年十月廿日午時書了 深禅夲(第三轉)」, 「以小野僧正御夲理趣房書御夲也(初轉)」, 「承暦四年十一月十二日給預又書冩并傳受了 峯大阿闍梨御房事也(第二轉)」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "奥書に「康暦元年八月十二日於地藏院以平等坊永嚴自筆夲書冩之訖 東寺沙門道快」, 「同十四日於同院以或夲重挍合入落字注異説削謬詞尤可秘藏而已」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "表紙の貼紙に「康暦元年八月十二日於地藏院以平等坊永嚴自筆本書写之訖 東寺沙門道快 南北類」とある",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻子本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "淡墨界の料紙を使用(界匡廓: 19.5×2.0cm)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「僧正弘基」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
