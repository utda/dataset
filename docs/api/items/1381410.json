    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "題簽の書名: 梅暦發端 : 恵の花",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "のどの書名: 梅發(前編), 惠(後編)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "自序中の書名: 惠の花",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻冊次表示は題簽による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "自序末に「申の孟陽 金龍山下狂訓亭 為永春水誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後編の序末に「南仙笑楚満人六年以来改名してますます発行の詮穿家為永春水の需に応じ此巻中では初編よりおなじみ深き辰巳の小庵稲荷横町の南窓に 櫻川由次郎謹誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "前編: 卷之1-3. 後編: 2編上中下之卷",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界8行, 内匡廓: 15.5×9.7cm, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序, 口絵は色刷",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "合冊後印本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「青洲文庫」(渡辺信), 「澤次郎」(渡辺沢次郎)",
            "is_public": true,
