    "bibo:annotates": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "書名は表紙による",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "小口書: 誹諧八部集",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: そのはまゆふ, あるとき, しみしう, しむにひやくいむ, わかはあはせ, たれかいへ, ひさこ, さむしやうのきむ",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『或時』の跋末に「元禄甲戌年無射神叔跋」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『蠧集』の序末に「貞享甲子中元日」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『新二百韻』の巻末に「天和三癸亥年夷則上旬」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『嫩葉合』に[序]末に「元禄九丙子稔五月仲旬」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『ひさこ』に[序]末に「元禄三六月 越智越人」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「秀印」, 「南葵文庫」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
    ],
