{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1381293",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "疏の書名: 東福海蔵禪院重刋元亨釋書",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 尺",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "目録の冒頭に「大日本國延文庚子六月有旨入毘廬大蔵海蔵禪院寓居比丘單況等謹募衆縁恭爲今上皇帝祝延聖壽文武官僚資崇禄位國泰民安命工鏤梓與大蔵經印板共行一部計三十卷旹貞治三年甲辰正月日謹題」, 卷第28末に「斯卷者平安城人上池軒主惠勇捐財繡梓于時永和三祀丁巳九月也」との原刊語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表末に「元亨二年八月十六日臣師錬上表」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "疏末に「至徳元年甲子六月日疏」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「慶長乙巳歳仲夏日 下村生藏刋之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界9行17字, 内匡廓: 21.6×17.5cm, 中黒口双黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第3-5は拠寛永元年跋刊本補配 (四周単辺無界9行17字, 内匡廓: 22.5×17.1cm, 中黒口双花魚尾)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第3-5は付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引, 朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記:  「十輪院」, 「恭温」, 「寂然」, 「明運」, 「萬徳」, 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
