{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1360643",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[1]の奥書に「此一巻従所々借請之謄写令部類了尚捜索可補漏脱矣 此巻中文永妙槐記不知記等曽祖黄門殿御筆也不閉而今猶在凾底仍閉入了 弘化四稔季秋 右権少将定功」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[2]の奥書に「此即位記数策曩祖代々御筆等也数拜閲之有散乱之恐仍今私合巻了 弘化四年九月四日 右権少将定功」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[3]の奥書に「此即位記数策曩祖代々御筆等也数拜閲之有散亂之恐仍今私令合巻訖 弘化四稔九月四日 右権少将定功」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[4]の奥書に「即位記数策曩祖御筆等也数拜閲之有散乱之恐仍今合巻了 弘化第四之暦季秋初四 右権少将定功」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[5]の奥書に「右即位記数本曩祖代々御筆等也数拜閲之有散乱之恐仍令類聚合巻了 弘化四年九月四日 右権少将定功」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「藤定功印」,「野宮藏書」,「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "各表紙の貼紙に「野宮筆」と墨書あり(「五冊ノ内」と朱書あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "各表紙の貼紙に「改の七」([1])「改ゐ七」([3])「改う七」([4])「改お七」([5])と墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
