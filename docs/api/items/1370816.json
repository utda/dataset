    "uparl:additionalDescription": [
        {
            "@value": "首冊は忠義水滸全書を底本とする鋪鈔、第二冊は一百回容与堂刻本後修本および李氏焚書にもとづく補鈔、第三冊は一百回和刻本による補配。朱墨の書き入れあり。版心に虫損あり。第一帙、第二帙、第三帙内側に「醉竹軒」による筆記、第四帙内側に神山閏次「水滸傳諸本」の中国語訳文貼付さる。",
            "is_public": true,
            "property_id": 389,
