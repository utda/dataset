    "dcterms:description": [
        {
            "@value": "写本残片",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "題簽に「出鄯善縣土峪溝 素文珍藏」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "識語に「為楊枝甘露滴入紙中展巻把玩但覺異香盈字 晉卿」, 「右二紙係亜利安字 晉卿」, 「右二紙係畏吾児字 晉卿」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "蔵書票に「殘經佛像梵字 十五段 鄯善」, 「梵字第一號」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻子本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "箱入",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「臣樹枏印」, 「晉卿」, 「王仲子」, 「王樹枏印」",
            "is_public": true,
