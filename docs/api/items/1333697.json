    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 重刋救急易方",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序に「近揚州守三山楊公成玉到任不久出行部驗災傷 ... 乃命工以救急易方重新翻刋将欲家給一冊 ...  成化己亥冬十月初吉 賜進士出身河南按察司副使致仕古雄高宗本書」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界10行20字注文双行, 内匡廓: 20.1×12.3cm, 中黒口双黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原1冊を2冊に綴じ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「大正四年五月畫餅居士讀了」との墨書あり(落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「養安」(鼎形印), 「養安院蔵書」(曲直瀬正琳), 「太田氏蔵書記」, 「森氏開萬冊府之記」(森立之), 「畫餅居士」(中島棕隱), 「三井家」, 「大正十四年所得」 (三井高堅)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
