    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の巻頭書名: 救荒夲艸(巻之2), 救荒本艸(巻之5), 救荒本草(巻之6), 救荒夲草(巻之9), 周定王救荒本艸紀聞(巻之[12]), 周定王救荒夲草紀聞(巻之[13]), 周定王救荒夲艸紀聞(巻之[14])",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名: 救荒夲草紀聞",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "補の巻頭書名: 救荒夲艸紀聞",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 救荒紀聞",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「本草綱目」(水草, 石草, 苔類, 穀之1-2), 「名醫別録」の抜抄を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「此書家大人幼弱時侍聴於田邨先生所聞紀予戊申秋取而糊製頗有逸脱囙補抄以道純夲末附本綱記聞數葉道純亦當時共侍同紀然互有出入異同詳廉於是今亦補標于彼之所長所詳以備後日之看予先不誌支干此來有故往々改觀救荒於是乎今追書于先年往事如此云嘉永七甲寅九月二十有四日題誌馬米華佗術速讀書屋中一日 ... 約之即跋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉10-11行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「森氏」(森約之), 「男爵田中美津男氏寄贈先代田中芳男男旧藏書/昭和七年」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
