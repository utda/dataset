    "dcterms:date": [
        {
            "@value": "[明治大正年間]",
            "is_public": true,
            "property_id": 7,
            "property_label": "Date",
            "type": "literal"
        }
    ],
    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "敘に「松本百藏君我が東京帝國大學に縁故ある諸君の筆蹟を蒐集シ己ニ三卷をなす此卷収む事といわは故子爵井上毅先生をはじめとし神保小虎博士に至るまで十二君の消息なり ... 大正十四年春日三上参次(花押)」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "跋に「松本百藏奉職東京帝國大學勞使四十年夙昔不怠其所勤非尋常也大正十四年以古稀辤其軄以平生所収簡牘装潢之得四巻二帖納大學書庫 ... 大正十五年五月於東京帝國大學夲部象軒平野直文識」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "その他の筆者: 八代六郎, 垪和爲昌, 鶴田賢次, 長井長義, 久原躬弦, 藤澤利喜太郎, 小藤文次郎, 寺野精一, 青山胤通, 佐藤三吉, 神保小乕",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻子本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "往来書簡貼付集",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "落款朱印: 「士可」, 「虚坣居士」, 「平野直文」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
