    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末の識語に「此蟲譜ハ尾張名古屋藩士雀巣庵吉田平九郎君ノ著より名古屋水谷助六ニ頼み写し了ルハ廾二年春ニテアリし今装針シテ五冊とナス 廾三年二月田芳記」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 1-2: 蜂類. 3-4: 蛾類. 5-6: 甲蟲類. 7: 蝿類. 8: 雜蟲類. 9: 䘀螽類. 10: 蜻蜓類. 11: 蜘蛛類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「男爵田中美津男氏寄贈先代田中芳男男旧藏書/昭和七年」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
