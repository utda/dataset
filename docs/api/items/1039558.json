    "archiveshub:note": [
        {
            "@value": "大尾及び原封面の書名: 痧脹玉衡全書",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序の書名: 痧脹玉衡",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "據康熙14-17年序檇李郭氏東書業刊本重刊",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原封面に「博愛堂藏板」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥付に「享保九甲辰二月朔日 江戸本石町三町目 書林前川權兵衛 同通油町 板木屋甚四郎彫刻」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺無界9行20字、単魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥付に「前篇共三巻之内 三折庵藏書(「定靜之印」朱印)」と墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
