    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "目録の書名: 増補六臣註文選(首), 六臣註文選(尾)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表の書名: 李善上文選註",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第11の題簽書名: 文選 : 六臣註",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の註者: (唐) 呂延濟, 劉良, 張銑, 李周翰, 呂向",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下に「梁昭明太子撰 五臣并李善注」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]末に「明州司法叅軍兼監盧欽謹書」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「慶長丁未沽洗上旬八蓂 板行畢」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界10行22字注文双行, 内匡廓: 23.3×16.6cm, 中黒口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "五つ目綴じ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "銅活字版後印本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾に「壬戌(元和八年板成而後十六年也)仲秋十又九日 羅山山長道春(明暦三年丁酉羅山沒)誌」, 「寛文十年庚戌孟秋二十八蓂」との補鈔あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第4末に「文化十閼逢淹茂玄月哉生明」との朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 墨筆付訓あり(胡粉による修正あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「幸彦之印」, 「江戸學山書屋」, 「松本氏圖書印」, 「勝鹿文庫」(松本月痴), 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
