    "archiveshub:note": [
        {
            "@value": "序中及び後付題簽の書名: 論語集解",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「今集諸家之善説記其姓名有不安者頗爲改易名曰論語集解 ... 臣何晏等上」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「友傳刋」, 「長十四年己酉九月日 洛汭宗與開板」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界7行17字注文双行, 内匡廓: 21.2×15.4cm, 中黒口双黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の冊次表示: 乾, 坤 (後付題簽). 上, 下 (小口書)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
