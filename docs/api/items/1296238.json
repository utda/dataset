    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "題辞に「學海拾遺珠 大正十二年初夏 讀律書屋主人題」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻末識語に「東京帝國大學の地小丘有り丘上に會議所有り總長教授等會食聚議の處と為に松本君其の役たると久し親しく碩學大家に接し之を敬するを知る留意して敗紙中に諸家の手跡を索め嵗月を累収て十数家に及へは輙ち裝潢して卷を成す今や第三卷成り文を予に求む松本君孤影孑然會議所に起臥す伴侶は唯名家手簡と手栽の盆柎有るのみ ... 大正十二年二月十九日 隨軒學人」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "その他の筆者: 和田垣謙三, 川瀬善太郎, 高松豊吉, 田中義成, 永井久一郎, 中村恭平, 山川健次郎, 松井直吉, 松村任三, 古在由直, 寺尾寿, 櫻井錠二, 清水彦五郎",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻子本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "往来書簡貼付集",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "名録1冊(大和綴)を付す",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "落款朱印: 「讀經堂主人號随軒」, 「服部宇之吉印記」, 「直文」(平野直文)",
            "is_public": true,
            "property_id": 4,
