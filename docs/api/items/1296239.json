    "dcterms:date": [
        {
            "@value": "康永2 [1343] 奥書",
            "is_public": true,
            "property_id": 7,
            "property_label": "Date",
            "type": "literal"
        }
    ],
    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "本文末に「貞永元年七月十日 沙弥浄圎/相模大掾藤原業時/玄蕃允三善康連/左衞門少尉藤原朝臣基綱/沙弥行然/散位三善朝臣倫重/加賀守三善朝臣康俊/沙弥行西/前出羽守藤原朝臣家長/前駿河守平義村/前攝津守中原師貟/武蔵守平泰時/相模守平時房」との連署名あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻末に「嘉禎三年八月十七日評定之」, 「延應二年五月廾五日評定之」, 「暦仁元年十二月十九日評定之」, 「延應元年九月廾日評定之改嫁事」, 「仁治三十二五評定」, 「嘉禎四年九月二十七日評定之」, 「仁治四二廾五追評定之」, 「延應二年五月廾五日評定之」, 「延應二四廾五評」など追加補抄及び「御式目事」(貞永元八月八日 武蔵守御判/するかの守殿)書簡抄を付す",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "奥書に「康永二年三月三日於高辻冨小路宿所書冩之訖」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "毎葉7行17字注文双行",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "本文は真字, 送り仮名, 返り点を施し",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "金砂子散し花菱繋ぎの見返し, 押界を施した楮紙打紙を使用",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "軸物(打紙継ぎ)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "桐箱入り",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「本立堂記」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "汚損, 虫損あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
