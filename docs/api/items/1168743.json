    ],
    "dcterms:description": [
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "原奥書に「右亀卜之次第亀卜抄新撰亀相記者卜部家極秘之書也有縁写認之本書間多錯誤不有無疑後日以正本校合之可也 正徳三年癸巳六月朔日於下舘城中太夫丹治直重書」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『龜卜次第』: 巻末に「右以家本遂書功畢 慶長十三年九月吉曜日 神龍院梵舜」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『新撰亀相記』: 巻末に「右亀卜抄端六枚半環翠軒宣賢正筆奥者息男業賢自筆也以正本書之予於燈下書写文字已下誤眼中無正体耻他見了 元和六庚申年二月十五日 神龍院龍玄六十八歳 次正廿三筆之二十二書終追而遂校合了」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「陽春廬記」,「南葵文庫」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり(巻末に「神龍院 豊國大明神社務司萩原従二位弟(私考)」と朱書あり)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "挟みもの: 「此ヨリ新撰亀相記(「英□之印」朱印)」とある紙片1枚",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
