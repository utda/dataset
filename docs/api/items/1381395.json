    "archiveshub:note": [
        {
            "@value": "巻之8の巻頭書名: 春色梅美の婦祢",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[初編]の序首書名: 春色梅美婦禰",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 梅見乃婦祢, 梅見の婦祢",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "のどの書名: ふね, 梅見, うめ, うめみ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻之1-7の内題下に「梅園英對の拾遺」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[4編]の序末に「辛丑之秌日 静春主人」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[4編]の巻末に「文永堂 大嶋屋傳右衛門」の「處女香」広告あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾に「販元 文永堂主人」の識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[初編]: 巻之1-3. 2編: 巻之4-6. 3編: 巻之7-9. [4編]: 巻之10-12. 5編: 巻之13-15",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
