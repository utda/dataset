    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1229822",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は帙背による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "裏表紙に「天保庚子己亥戊戌丁酉正月吉旦/此書取諸家竒談妙方或當世之竒談附之而以備健忘蓋又使楽目説心之一端而已云爾 傳經樓主人識」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「養拙亭藏」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "代銘, 東洞家方, 傷寒論記聞, 疱瘡療治方記聞, 軍陳, 篆書千字文, 千金方などを記す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心下部に「玉巌堂」とある四周双辺有界7行罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「海保先生遺書」, 「島田氏雙桂樓収臧」(島田篁村), 「南葵文庫」, 他1顆あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
