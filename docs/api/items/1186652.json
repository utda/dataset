    "archiveshub:note": [
        {
            "@value": "卷第1の巻末書名: 増一阿含經",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "品首の書名: 増壹阿含",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 増一阿含",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に「釋道安作」序あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾刊語に「奉再興 佛説一切經藏/今上皇帝 玉體安穩/東照權現 倍増威光/征夷大將軍左大臣源家光公武運長久/四海泰平 國家豐饒/佛法紹隆 利益無窮/日本武州江戸東叡山 山門三院執行探題前毘沙門堂門跡 大僧正天海願主/寛永十六己夘暦十二月九日 林氏幸宿花溪居士使工人彫鏤之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "各巻末に音釋を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻頭, 巻末, 版心の函号表示: 蘭(卷第1-10), 斯(卷第11-20), 馨(卷第21-30), 如(卷第31-40), 松(卷第41-50)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "天地単辺無界12行17字, 内匡高: 22.1cm",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "木活字本",
            "is_public": true,
