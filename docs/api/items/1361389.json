            "type": "literal"
        },
        {
            "@value": "原奥書に「借請宰相中将定基卿本惟通卿書冩畢 寳永年正月廿四日 内大臣(花押)」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "奥書に「借請件奥書本於源前内府(通兄公)令書冩了 寳暦第二ノ季冬正三位□□(花押)」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "仮綴",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱墨書き入れあり(巻末に「宝暦二季冬一校了 愚然」と朱書あり)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
