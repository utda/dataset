    "dcterms:description": [
        {
            "@value": "書名は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "原表紙の書名: 故實秘書",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "原表紙に「高照山豪一冩之」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『無動寺諸講説用意』: 原奥書に「此書者無動寺常樂院等海法印自記自筆矣原是権僧正章海所持焉一日入於覺林坊之學?見之慇懃求而次遂書功可謂昏衢之炬燈濁世之明鑑 萬治二己亥暦自東叡皈吾山渉于数月隅居於滋賀院御房節馳禿毫拭老眼写孟冬初九合瓜和南 元文四年己未三月九日光海謹写之双附三光院常住焉」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『無動寺諸講説用意』: 奥書に「延享三丙虎十一月高照山豪一写之」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『?討阿闍梨宣旨之事』: 奥書に「右延享二年御上洛ニ付豪一致上京記之」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "『山門格式考』: 奥書に「右條々者天和年中南紀中納言光貞卿之願にヨツテ油小路大納言隆貞卿記之云々惠心院大僧正之本を以写之」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「□□」,「豪弌」,「南葵文庫」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損あり(裏打ち補修あり)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "【内容注記】講演故實覚書 / 義空記",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
