{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1002061",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "表紙の書名: 愛人集(墨書), 易林節用集(朱書)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻冊次は版心による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「十幹」, 「十二枝」, 「十二時異名」, 「京師九陌横竪小路」, 「名乗字」, 「分毫字様」, 「[四声]証疑」, 「南瞻部州大日本國正統圖」を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋に「有客携鋸巻曰此節用集十字九皆贋也正諸於韻會禮部韻諾則命工刻梓焉如愚夫弄麞何辨字畫之誤哉惟取定家卿假名遣分書伊為越於江惠之六隔段以返之云峕慶長二丁酉易林誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙による巻冊次表示: 乾, 坤",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界毎半葉7行注文双行, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "片仮名付訓",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "上: 68丁, 下: 72丁",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠慶長2(1597)跋刊本重刻後印",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
