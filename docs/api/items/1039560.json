        },
        {
            "@value": "題簽の書名: 十四經抄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「正保三年丙戌秋都下醫生請予講斯書倉卒之求隨藁隨講未遑琢磨猶須暇日而考正焉耳 隱士某書于徳生院下(朱印)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「森氏」,「青山求精堂藏書畫之記」他1印",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
