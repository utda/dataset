    "dcterms:alternative": [
        {
            "@value": "20歳から36歳の女性の皆さん、海軍で働きませんか。WAVESに参加しましょう",
            "is_public": true,
            "property_id": 17,
            "property_label": "Alternative Title",
            "type": "literal"
        }
    ],
    "dcterms:description": [
        {
            "@value": "Women 20 to 36 / Earn a Navy rating based on Navy Training and your own ability and experience. Same grades—same pay—as for men / Steps in advancement (For radioman, illustrated, or other specialties) / Pay-$50 to $126 a month clear—free uniforms. Allowances for food and living quarters—a wonderful opportunity to serve your country / Specialty marks—Worn by the WAVES",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "女性兵募集。階級と職能別のバッジの模様などが描かれている。WAVE（海軍女性予備部隊）は1942年に創設されたが、1970年代に至るまで、海外勤務は実施されなかったという。",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
