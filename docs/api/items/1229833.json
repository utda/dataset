    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の巻頭書名: 詞華和歌集(卷第2), 詞花和歌集(卷第3), 詞花和哥集(卷第5)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "極札袋の書名: 詞花集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本奥書に「此集奉天子綸書 崇徳院脱屣 撰者 右京大夫顕輔 右少将藤原朝臣在判」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「弘安第七暦初冬中旬之比 ... 藤原朝臣在判」, 「時永正九年六月上旬比以此奥書夲書写之他見有其憚者也 法眼孝我」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉10行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "金砂子に雲霞見返し, 花菱繋ぎ文様の緞子表紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「冷泉為和之是孝我筆 詞花集ノ札」, 「詞花集筆者小傳」との極札3枚を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
