            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朝鮮刊本(甲寅字体木活字)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
