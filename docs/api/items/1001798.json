        {
            "@value": "題簽の書名: 藤谷集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書に「歌數三百七首此内入撰集六十三首」, 「從二位中納言爲相卿/冷泉又藤谷又高倉/哥鞠宗近 頭大納言爲家四男/母後号阿佛遠江守平度慶朝臣女」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「保午晩夏念五以一本校之七十翁北慎言」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉11-12行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「楓□」, 「坂田文庫」(坂田諸遠), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
