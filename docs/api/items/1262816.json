        }
    ],
    "bibo:annotates": [
        {
            "@value": "巻冊次はのどによる",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "見返しに「書林 金養堂」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥付に「東都書林 本石町十軒店 萬笈堂英平吉/兩国吉川町 文會堂山田佐助/高砂町 金養堂若林半七」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界10行, 内匡廓: 11.8×8.4cm",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "上: 春, 夏之部. 下: 秋, 冬, 雜之部",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「南葵文庫」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損, 破損あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
