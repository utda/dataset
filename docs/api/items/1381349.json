    "archiveshub:note": [
        {
            "@value": "書名は表紙(墨書)による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名: つれづれ草",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名の繰返し部分は踊り字",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「這両帖吉田兼好法師燕居之日徒然向暮染筆冩情者也頃泉南亡羊処士箕踞洛之草廬而談李老之虚無説莊生之自然且以晦日對二三子戯講焉加之後将書以命於工鏤於梓而付夫二三子矣越句讀清濁以下俾予糾之予坐好其志忘其醜卒加校訂而己復恐有其遺逸也 慶長癸丑仲秋日 黄門光廣」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉10行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "金砂子に花草遠山雲霞見返し, 薄黄紙板表紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大和綴",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
