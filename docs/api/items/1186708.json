    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名: 難後拾遺",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「此書ハ大納言經信之作也 元禄十年八月中旬憑或人借洛下松下見林之夲寫之書冩之間忽記憶得夲歌等以朱注之迄 愈訛宗沙門 契沖」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「明治十一年十月六日 宇米の舎古叟しるす(花押)」, 「此卷まきはもと水野越前公の所藏なりに今ゆくりなく吾宝となりぬ」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙に「契沖阿闍梨自筆本」との朱書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉11行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「原宿文庫」(片野邑平), 「交埜藏書」(交野時万), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
