    "bibo:annotates": [
        {
            "@value": "[序]中の書名: 翁の手かゝみ",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[序]末に「嘉永三年庚戌初夏」とあり (落款印「嵯峨野樵」, 「石外隠士」とあり)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[跋]に「来るうしの秋は去来先生の百五十年の遠忌にし侍れは四方の諸風子手向種の連句発句希ものなり/落柿舎執事」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "刊記に「嘉永三庚戌年初秋再板/落柿舎後主 紀石外所藏」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界",
