    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "書名は[序]首による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「是冊子ハ和蘭地理の記セル一二ノ書中ヨリ採録シテ己ヲ譯記シ座右ニ置テ他日ノ校補ニ供ル草稿ニ属スモノナリ 寛政己酉春二月 蘭化識」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「柬察加志」末に「寛政辛亥春正月 前野良澤熹」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「享和元年辛酉嵗二月十四日冩 改元昨十三日被仰書 太田方」とあり (「太田方印」, 「字叔龜」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界9行の罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「太田郎藏」, 「天与賢人与貧太田方記」(太田全斎), 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
