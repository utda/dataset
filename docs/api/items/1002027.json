    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "『六根清淨大秡』, 『神道大意』(兼直撰)の奥書に「于時寛文六年五月二日 相山隱士惟足謹書 從時(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "『神道大意』(兼倶撰)の奥書に「此一卷尾張東照宮之祠官吉見幸和之所藏也 卷末所捺之黒印則吉見氏之為印明亮有故予掌中之為珎蔵 荒木田五十槻 久老」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末の識語に「右のひとまきは神道哥道名高き吉川惟足翁の遺蹟なり ... 宇米のやのあるし 讀古しるす(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の貼紙に「國書 三通合」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉6行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆付訓, 書入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「吉見氏」(吉見幸和), 「原宿文庫」(片野邑平), 「交埜蔵書」 (交野時万), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
