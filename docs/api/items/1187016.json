{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1187016",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "巻下の巻頭書名: 東叡山寛永寺慈眼大師縁起",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 慈",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「余嘗自幼侍師之座下。而無日不相追隨。恰如形影之相從。然故其舊勲積徳取所識之者而作其傳。癸亥已前之事跡者。亡父宗伯所悉識之者也。仍詳誌之。垂不朽世言先師之異行者。徃々有異于與實者。只以此記可為證而已 慈眼末弟僧正胤海記」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「此兩大師御縁起者東叡山雖為祕鑑之靈書蒙御免許奉繍梓流布于世間者也於他所不可有類板之旨任嚴命加奥書畢」あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「延寳八年龍集庚申仲冬穀旦 江戸通本町三町目 村上嘉右衛門/同 善兵衛 刋行」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界10行, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "句点, 付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「沙門雄賢」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「文化十二年乙亥孟夏朔杏花園 ... 大田覃」との識語あり (「風光永与」, 「南畝」, 「覃」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「南畝文庫」, 「大田氏臧書」(大田南畝), 「長井之章」,  「豊山」(山口豊山, 象形印), 「陽春廬記」(小中村清矩), 「石塚文庫」(石塚豊芥子), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
