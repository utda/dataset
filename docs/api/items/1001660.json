        {
            "@value": "版心の書名: 續世",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
