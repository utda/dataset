    "archiveshub:note": [
        {
            "@value": "巻尾及び目首の書名: 重訂唐王燾先生外臺秘要方",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "凡例の書名: 翻刻外臺祕要方",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序の書名: 外臺秘要方, 較正唐王燾先生外臺秘要方, 外臺秘要, 重刻外臺秘要方, 重刻外臺秘要, 飜刻外臺祕要方, 重刊外臺秘要",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "叙の書名: 校正外臺秘要方",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原封面の書名: 重校唐王燾先生外臺秘要",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉及び題簽の書名: 外臺祕要方",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "據崇禎13年新安程衍道經餘居重校刊本重校刊(後修)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原封面に「新安程敬通訂梓」「此書肇集于唐再鐫于宋自元迄今未有刻板不佞購得寫本訛舛頗多殫力校讐付諸剞劂期以流傳宇内用爲醫家考古者之一助云 歙西槐塘經餘居藏板」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉に「明版翻刻宋本校勘」「平安養夀院蔵版」とあり (「寶暦再訂之記」の朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心下部に「養壽院藏」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "天地双辺有界10行22字、単魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「土肥慶藏(白澤)」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "蔵書票: 「土肥藏書」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
