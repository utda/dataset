    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 桃花扇",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小引の書名: 重刋桃花扇",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "封面に「西園梓行」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小引末に「康熙己卯云亭山人偶筆」, 「先大人遯叟公慨然念此書不可匣於後人之日久欲重刋以代抄冩之苦而同志絶少遂不能計日成功庚申春大人遊淮上與水南道人程子風衣言及此舉程子欣然共勷之歸即刻期示匠人 ... 旹乾隆七年壬戌仲秋上浣愚亭居士沈成垣識于清芬」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷1: 第1-9齣. 卷2: 第10-閏20齣. 卷3: 加21-29齣, 卷4: 第30-續40齣",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界9行20字, 内匡廓: 14.1×9.8cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠康熙38(1699)小引刊本補刻",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「一武紫溪」, 「玉巌」(太田玉巌), 「學海秘笈」, 「依田氏臧」(依田学海)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
