    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "目首の書名: 揚子雲集",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下にの責任表示: 漢成都揚子雲著 明新安□□□校(埋木あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第1: 賦. 卷第2: 騒. 卷第3: 箴",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「楊子雲傳」末に「明治己亥秋九月念四日讀此本似汪士賢而挖其汪士賢三字者 島田翰記二十一歳」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界9行20字, 内匡廓: 19.6×13.5cm, 白口単白魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠明末新安汪士賢校刊本入木後修",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙貼紙に「玄尚白」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「養安院蔵書」(曲直瀬正琳), 「平野中印」, 「子和」(平野金華), 「窵不盈舌」, 「酉爾古人斉生」, 「島田翰字彦楨精力所聚」,「島田氏雙桂樓収臧」(島田篁村), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
