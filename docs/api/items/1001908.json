            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽に「趙大沅註」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に「孟子題辭」あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「關東上総住今關正運刋」とあり",
