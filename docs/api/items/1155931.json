        {
            "@value": "書名は[2]の扉による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "その他の扉書名: 日用三昧[1], 日録[2], 居諸集[3], 居諸記[5]",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "[1]: 天文18年正月-19年10月4日. [2]:文禄3年正月-12月. [3]: 自慶長20年正月-7月13日. [4]: 自元和元年7月14日至元和2年4月晦日. [5]: 自元和2年5月朔至元和3年11月朔",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "付紙に「相國寺鹿苑院の僧禄司の記録にして、足利時代より徳川初期に至る。災前三十五冊を有せが今五冊のみを止む」との識語あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "付箋あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "極札1枚を付す",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「慈照院」, 「茂内道順」",
            "is_public": true,
