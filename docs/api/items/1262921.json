    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "国文学研究資料館「歴史的典籍NW事業」によるデジタル化",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
    "bibo:annotates": [
        {
            "@value": "扉の書名: 本朝文選",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "扉裏の書名: 五老文庫",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "目首の書名: 風俗文選",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "後序の書名: 以呂波文字",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 文",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "自序末に「寳永二乙酉嵗自序して凬俗文選とは云尓」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[跋]に「右此夲朝文選全部十巻者五老井許六先生之撰也 ... 書林井筒屋彫之梓全無一字誤  ... 寶永三丙戌年秋九月吉日/五老井門人」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "刊記に「洛下二條下寺町/野田弥兵衛尉梓」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 1: 序目, 辞. 3: 賦, 譜. 4: 説, 解. 5: 記, 紀, 序. 10: 論, 頌, 讃賛, 書",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻之6-9を欠く",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界11行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『本朝文選』寳永3[1706]跋刊の改題後印本",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「厲掲精舎」, 「隨時藏書」, 「木嵜氏藏書印」, 「千載之存」,  「卍戸千門平日開」, 「東海」, 「布雨樓」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
