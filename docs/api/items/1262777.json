    "bibo:annotates": [
        {
            "@value": "題簽左肩単辺「俳諧道の便 上(下)」(「の」は変体かな)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "序首の書名: 道の便",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "のどの書名: 道便",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "序末に「享和二年戌九月 生々瑞馬」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "見返しに「文政壬午新鐫」, 「平安竹巣月居著/東都書肆 千種房蔵版」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥付に「天保十二丑年京都寺町通松原下ル 勝村治右衛門/寺町通二條下ル 野田治兵衛/心齋槗北久太郎町 河内屋喜兵衛/芝神明前 岡田屋嘉七/中槗廣小路 西宮弥兵衛/日本槗通二丁目 小林新兵衛/同所 山城屋佐兵衛/同壹丁目 須原屋茂兵衛/同四丁目 同佐助/淺草茅町二丁目 同伊八/本石町十軒店 英大助」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻末に「江戸本石町十軒店萬笈堂英大助藏版俳書目録」(5丁)を付す",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 上, 下",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界10行, 内匡廓: 12.7×8.8cm",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
