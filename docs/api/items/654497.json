    "dcterms:description": [
        {
            "@value": "Let's fly this flag / Everybody at least 10 percent in war bonds",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "従業員が自分の給料の少なくとも10%を戦時公債に充当させることに同意した会社や工場では、このような旗が掲げられることになった。旗に描かれているのは独立革命時に活躍した市民兵「ミニッツ・メン」である。独立時の13州を象徴する13個の星に囲まれたこの表象は、戦時公債への協力を求める “Buy war bonds”の標語とともにしばしば登場する愛国的イメージである。",
            "is_public": true,
            "property_id": 4,
