    "archiveshub:note": [
        {
            "@value": "折本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「湻化五秊嵗在甲午春王正月潘師旦奉聖㫖摹勒上石」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽に「即偽絳帖」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第6-7: 晋王献之. 卷第8: 晋劉伶 [ほか]. 卷第10: 唐張旭 [ほか]. 卷第11: 唐李建中 [ほか]. 卷第12: 唐孫過亭 [ほか]",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨紙匡廓: 26.1×13.2cm",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "石版濃墨刻拓本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "木挟板",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「翰林之印」, 「宣徳御寶」, 「尚寶少卿袁氏忠徹印」(袁忠徹(1377-1459)), 「檇李項氏世家宝玩」, 「子京」(項元汴(1525-1590)), 「研山齋」(孫承澤(1592-1676)), 「渡邉氏圖書記」(渡辺春英)",
