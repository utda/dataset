        },
        {
            "@value": "小口書: 誹諧三部集",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: すさむ, のほりつる, せむりやうのふ",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『杜撰集』の巻末に「元禄十四辛巳年六月中旬挍合之/雷堂百里/露堂々氷芲」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『のほり靏』の跋末に「序令跋す/甲申建子月日」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "『銭龍賦』の[跋]末に「寳永二年乙酉九月大日/綏々閑人述」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「秀印」, 「南葵文庫」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
