    "dcterms:description": [
        {
            "@value": "序末に「于時元久甲子之?初秋壬申之日朝議大夫源光行閑居暇慨然記之云尓」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "奥書に「此両策以素菴艸本令冩之惜矣不全逐旋可書加耳 .. 壬申季春十五日 古勝子誌」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 上, 下",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "第1: 春部. 第2: 夏部. 第3: 秋部. 第4: 冬部. 第5: 戀部.第6: 祝部. 第8:羇旅部",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「福地文庫」, 「陽春廬記」, 「南葵文庫」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
