{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1229970",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 刻資治通鑑, 音註資治通鑑",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋の書名: 翻刻資治通鑑",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しの書名: 資治通鑒",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 通鑑",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しに「天保丙申挍刋」, 「津藩有造館藏版」とあり (「有造舘記」との版元朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「刻資治通鑑序」に「余素好是書毎政暇輒熟讀而翫味焉因命傳臣挍勘漸次上梓會壬寅歳官諭矦伯行大部書籍於是督勵所司分曹執役不期年告成 ... 嘉永二年己酉冬十月 伊賀國主藤堂高猷撰」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋末に「大日本嘉永二年己酉冬十月 津藩國校督學臣齋藤正謙」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内容: 卷第1-5: 周紀. 卷第6-8: 秦紀. 卷第9-68: 漢紀. 卷第69-78: 魏紀. 卷第79-118: 晉紀. 卷第119-134: 宋紀. 卷第135-144: 齊紀. 卷第145-166: 梁紀. 卷第167-176: 陳紀. 卷第177-184: 隋紀. 卷第185-265: 唐紀. 卷第266-271: 後梁紀. 卷第272-279: 後唐紀. 卷第280-285: 後晉紀. 卷第286-289: 後漢紀. 卷第290-294: 後周紀",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺有界10行20字注文双行, 内匡廓: 21.0×14.2cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠天保7(1836)津藩有造館刻本再校刊",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「誠堂圖書」(徳川茂承), 「舊和歌山徳川氏藏」, 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
