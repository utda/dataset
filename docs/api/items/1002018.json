            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「信長記起」に「慶長甲辰ノ春アヤシキ夢ノ告アリ ... 改テ重テ刋行センニ其便又不美乎」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界12行, 内匡廓: 22.6×17.0cm, 中黒口双花魚尾",
