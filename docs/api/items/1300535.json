    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序首の書名: 夲草圖譜",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻之15-34の題簽書名: 本草啚譜",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「文政戊子冬至日灌園岩崎﨑常正」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之8の巻末に「棔齊 岡田清福摸冩」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻之24-29, 35-38の版心下部に「灌園閣藏」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻之65-70の内題下に校者名あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之5-8: 山草類. 巻之9-12: 芳草類. 巻之13-20: 濕草類. 巻之21-24: 毒草類. 巻之25-32: 蔓草類. 巻之33-34: 水草類. 巻之35-37: 石草類. 巻之38: 苔類. 巻之39: 雜草. 巻之40-42: 穀部. 巻之43: 菽豆類. 巻之44: 造醸類. 巻之45-47: 菜部葷菜類. 巻之48-52: 菜部柔滑類. 巻之53: 菜部蓏菜類. 巻之54: 菜部水菜類. 巻之55-60: 菜部芝栭類. 巻之61-62: 果部五果類. 巻之63-66: 果部山果類. 巻之67-69: 果部夷果類. 巻之70: 果部味類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "補写: 67(巻之39): 果部蓏類. 68-69(巻之40-41): 果部水果類. 70-71(巻之42-43): 香木類. 72(巻之44上): 香木類, 喬木類. 73-74(巻之44下-45): 喬木類. 75(巻之46): 喬木類, 灌木類. 76-78(巻之47-49): 灌木類. 79(巻之50上): 寓木類, 苞木類. 80(巻之50下): 苞木類, 雜木類, 服帛類, 器物類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "おもに図版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原欠: 卷之1-4",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「蜂須賀文庫」, 「男爵田中美津男氏寄贈 先代田中芳男男旧藏書 昭和七年」",
            "is_public": true,
            "property_id": 332,
