    "archiveshub:note": [
        {
            "@value": "版心の書名: 藻塩",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名(墨書): 藻鹽草(卷第1-2), 藻汐草(卷第3-4), もしほくさ(卷第9-10), もしほ草(卷第11-14)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内容: 卷第1: 天象部. 卷第2: 時節部 付方. 卷第3: 地儀部. 卷第4: 山類部. 卷第5: 水邊部. 卷第6: 居所部. 卷第7: 國部 付世界. 卷第8: 草部. 卷第9: 木部. 卷第10: 鳥部. 卷第11: 獸部. 卷第12: 虫部. 卷第13: 魚部 付貝. 卷第14: 氣形部 付所作. 卷第15: 人倫并異名部. 卷第16: 人事部 付所作. 卷第17: 人事雜物并調度部. 卷第18: 衣類部. 卷第19: 食物部. 卷第20: 詞部",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界10行20字注文双行, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字版(平仮名交り連続活字を使用)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後印本",
