    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾の書名: 日本紀竟宴歌",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥中の書名: 日本紀竟宴哥",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 竟宴哥",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に「日本紀竟宴各分史得 大鶴鷯天皇二首 元慶六年皇太后宮大夫藤原朝臣國經」あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「元慶六年 大納言国經卿一人二首 /延喜六年 三十六人此中四人各詠二首合四十首/上卷合四十二首三十七人 序一首 三統理平」(上), 「上下合八十三首 追加二首 猶豫歌三首 合八十八首」(下)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本奥書末に「元禄十三年正月日 契沖記之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書末に「伴信友に此書をかりてうつし竟ぬまた村田並樹のもたる契沖師自筆のうつしをかりえて挍合し竟ぬ 文化四年七月八日 藤原彦麻呂」(墨筆), 「同年九月卄九日多田義俊の校夲を得て挍合せり/文化五年三月十六日大石千引の抄をかりて挍合畢 彦丸」(青筆)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉12行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "青筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊徳川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
