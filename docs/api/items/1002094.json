{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1002094",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序に「和銅四年九月十八日詔臣安萬侶撰録裨田阿礼所誦之勑語舊辝以獻上者謹随詔㫖子細採摭 ... 和銅五年正月八月 正五位上勲五等太朝臣安萬侶」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書に「文永三年二月仲旬書冩畢 神祇權大副大中臣定丗判 ... 借請親忠朝臣一夲吉田大納言定房卿被所望之間依家君御命書冩進畢又一夲書冩之止之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「右古事記三卷奉仰以真福寺所蔵古夲書冩拠刋本度會延佳挍夲及一夲挍正之畢 ... 寛政十三年辛酉正月検挍保己一」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "上卷の見返しに「此書は塙検校の写したり真福寺本に拠りて内藤廣前翁の写させてみものなりを翁の歿後おのれの藏書となれり ... 慶応三年の秋 小中村清矩」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉8行18字注文双行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "修正貼り紙あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「賢木園記」(内藤広前), 「東洲文庫」, 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
