    "archiveshub:note": [
        {
            "@value": "卷之2-15の巻頭書名: 春色英對暖語",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序首の書名: 梅暦拾遺別傳(3編), 英對暖語(5編)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "のどの書名: ゑいたい, ヱイタイ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内題下に「梅ごよみ拾遺別傳」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「天保九戊戌年正月發行」([初編])「天保九戊戌年春正月發行」(2編)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "5編序末の広告に「米八婀娜吉丹次郎の物語類本目録」(文永堂販)あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[初編]: 卷之1-3. 2編: 卷之4-6. 3編: 卷之7-9. [4編]: 卷之10-12. 5編: 卷之13-15",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
