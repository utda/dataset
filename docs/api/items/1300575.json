    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本文中に「文政十二年」, 頭書に「弘化二年」との記述あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「文化甲戌夏四月より張州高泉道人識」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷之1:水禽. 卷之2: 原禽. 卷之3:林禽. 卷之4:山禽. 卷之5:異邦禽. 卷之6:附録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 上, 中, 下",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺有界11行罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊小原八三郎源良直藏書乃記」(小原良直), 「男爵田中美津男氏寄贈先代田中芳男男旧藏書/昭和七年」",
            "is_public": true,
