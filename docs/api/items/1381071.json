            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後序末に「書林王氏善敬堂謹於邑庠謄録繡梓以廣其傳」との刊語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
