    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「このあさちの一巻みつからかいて定和あそにまいらす 文政十年十二月十三日 樂翁(花押)」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉に「此安佐知一卷ハ文政十年十二月十三日白川樂翁公が自ラ認メタル墨跡ナリ ... 明治三十六年十二月十三日ニシテ偶然其月日ヲ同スル奇ナリト謂ベシ 藏原惟郭記ス」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "春, 夏, 秋, 雜部",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れ及び見せ消ちあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「南葵文庫」との押型表紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「宇治惟画」, 「藏原」(近藤正斎), 「□己巳」, 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
