    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉の書名: 播州舊記并寺社舊記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 播州旧記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書末に「手抄一本以藏旅装 享和改元辛酉孟夏念七梅雨中題於浪華船塲客舎 杏華園」とあり (「南畝」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末識語に「播州旧記者抄出峯相記備考而錯綜以為一書于読者与峯相記備考比挍上可也 文化三年丙寅端午前一夕 杏華園又識」とあり(「風光永与」, 「杏園」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉10行注文双行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「南畝文庫」, 「大田氏臧書」(大田南畝), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
