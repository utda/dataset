    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 閑艸拾遺",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名の繰返し部分は踊り字",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序に「朗如敏而好我文善修其古云近齎我文若干篇示余曰今吾獲白璧於市也斐然其辤兼好不啻也斯必閑艸之遺也 ... 元文庚申臘月壬寅 東野沙門徹雲洞序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「寛保四年甲子孟春 小川彦九郎板行」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界8行, 白口無魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「真顔」(北川真顔), 「麻生文庫」(麻生太賀吉), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
