    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "国文学研究資料館「歴史的典籍NW事業」によるデジタル化",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
    "bibo:annotates": [
        {
            "@value": "大尾の書名: から衣",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "見返しの書名: 折句五文字歌羅衣(初篇), 折句冠り五文字歌羅衣(3篇), 折句冠五文字歌羅衣(4篇)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "初-4篇の題簽書名: 哥羅衣",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "序末に「天保五つ/午初秋」(初篇), 「天保十五 東都/辰の秋 丹頂齋一聲」(8篇)とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "初篇の見返しに「判者居所口調手鑑」, 「丹頂齋蔵」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "5, 7篇の見返しに「折句五文字冠折込」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "3-5篇の奥付に「江戸書林 日本橋通十軒店 播磨屋勝五郎板」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界9行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "初篇の見返しに「玉川連 千鳥」との墨書あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「千鳥」, 「友恵」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "虫損, 汚損あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
    ],
