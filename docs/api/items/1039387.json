    "archiveshub:note": [
        {
            "@value": "書名は題簽(墨書)による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名: 疱瘡繪帖",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "その他の絵師: 芳盛, 芳宗, 國芳. 芳廉, 國虎, 國芳",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "南岱絵に「森本」, 芳盛絵に「伊」, 芳宗絵に「江崎屋辰蔵」, 國芳絵に「通油町 鶴喜」, 「池仲上​金」, 國虎絵に「山本屋平吉」の商標あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "附録8枚: [1]: 國虎画(山本屋平吉版). [3]: 正一位八郎大明神正像. [5]: 新板為朝公尽(馬喰町三丁目 江辰板). [6]: 上洲屋重蔵板. [7]: 國虎画",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "おもに図版",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "赤絵に狂歌添え",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "極印あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "芳盛絵に改印あり(「巳二」(安政4巳2月))",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "木版1枚刷りを合冊製本した張込帖",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "汚損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
