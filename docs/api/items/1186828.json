            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「春秋左傳哀下第30」, 「春秋左氏傳序」, 「春秋經傳集解後序」との補抄あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
