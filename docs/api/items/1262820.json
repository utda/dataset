    "archiveshub:note": [
        {
            "@value": "国文学研究資料館「歴史的典籍NW事業」によるデジタル化",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
    "bibo:annotates": [
        {
            "@value": "書名、巻冊次は表紙による",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻頭書名: 俳諧寂栞",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "版心の書名: さひしをり (変体仮名。記載は「さひ志を里」 )",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "書誌的巻数: 3巻員外1巻",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻頭の巻冊次: 天: 巻之上, 地: 巻之中, 人: 巻之下",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "巻之上表紙見返しに「春秋葊白雄著 拙堂老人補」「誹諧寂栞 全三册」「江都製本所」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "序末 「文化九年七月富小路從二位刑部卿貞直卿 如泥齋主人」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "次序末に 「文化九年申のあき 定種」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "後序末に「江戸詩人詩佛老人大窪行序」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "凡例末に「拙堂老人識」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "和装, 袋綴",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
    ],
