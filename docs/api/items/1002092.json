    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉の書名: 秋夜の長語 : 挍異本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: アキノヨ ノ ナガモノガタリ",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書に「嘉吉第二暦二月十五日於台嶺本院東溪成坊之學窓遂冩切訖 右斐紙主岩若丸」, 「明應八年己未六月廿五日於根本院東谷乗泉坊 ... 千代丸主十六ノ時」, 「寛文十四暦癸巳六月五日 一閑冩之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「小林久三郎寺地町東一丁に住のつかへもてる本を摹写して群書類從第六百十一に収める本を以て一挍しつ 明治十五年六月 小田清雄しるす」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に黒川真瀬との書簡抄(1丁)あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉9-10行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に貼紙1丁あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆による傍点, 傍注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「小田」, 「やすむろ」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
