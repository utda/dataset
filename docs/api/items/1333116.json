    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 好問堂儲藏書目",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻冊次は題簽による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "1の見返しに「これは山﨑美成おのれの藏書目を自筆にて記さたものや」と小中村清矩の識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "1: 神祗類, 國史類, 日記類, 補任類, 系譜類, 御記録類, 傳記類, 僧傳類. 2: 時令類, 地理類, 紀行類, 縁起類, 地圖類, 外國類, 官職類, 律令類. 3: 経類, 史類, 子類, 集類, 朝鮮類, 経論類, 釋家類. 4: 公事類, 装束類, 目録類, 儒家類, 兵家類, 武家類, 農家類, 醫家類, 暦日類, 藝術類, 譜録類. 5: 文筆類, 歌書類, 俳諧類, 狂歌類, 和文類, 古文書類, 墨帖類, 畫圖類, 金石類. 6: 雜家類, 字書類, 類書類, 物語類, 釋家類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の巻冊次表示(朱書): 禮, 樂, 數, 射, 書, 御",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "1: [60] 丁. 2:  [40] 丁. 3: [44] 丁. 4: [45] 丁. 5: [40] 丁. 6: [35] 丁",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界11行罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆による書目追加及び校正あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「待賈堂」(達磨屋五一), 「陽春廬記」(小中村清矩), 「不羈齋圖書記」(秋山恒太郎), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
