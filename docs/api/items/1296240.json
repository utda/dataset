    ],
    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻之2の巻頭書名: 辨證配剤醫燈",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "大尾に「治病用藥之時欲使侄姪孫一覧如指掌而已/旹元亀第二辛未年冬日南至六十五齢老眼寒窓/日東洛下雖知苦斎盍静翁 道三」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻末識語に「辨證配劑醫燈全三册壹帙一溪叟道三所親筆也不可忽諸故附一語於後耳」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "箱に「和氣道三自書寫配劑醫燈三卷林道春跋之櫻井老人苐一家藏子孫永寶之 葛辰識」との墨書あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "毎半面11行",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引, 朱藍筆書き入れあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "付箋あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "箱入り",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「石堂」, 「昃印」",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損, 汚損あり",
