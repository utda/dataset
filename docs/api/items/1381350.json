    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序中の書名: 論語集解",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後付題簽の書名(墨書): 天文版論語",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名(墨書): 天文本論語",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「泉南有佳士厥名曰阿佐井野一日謂予云東京魯論之板者天下寳也雖然離丙丁厄而灰燼矣是可忍乎今要得家本以重鏤梓若何予云善 ... 天文癸巳八月乙亥 金紫光禄大夫拾遺清原朝臣宣賢法名宗尤」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「今集諸家之善説記其姓名有不安者頗爲改易名曰論語集解 ... 臣何晏等上」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺有界7行14字, 内匡廓: 20.6×18.0cm, 中黒口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本文のみ, 集解無し",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後印本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原2冊を1冊に合綴",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽に「于水艸堂主人珎藏」, 「經籍訪古志所載舊本」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「原兼愛印」, 「于水艸坣之印」, 「謁者手薄紀氏藏」, 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
