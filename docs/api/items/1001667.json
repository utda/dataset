    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "揔目の書名: 新學行要抄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 行要, 雜事",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名(墨書): 新學行要",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本文末に「延文二秊十月廾六日於江州敏滿寺佛土院集記訖」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[跋]に「應安四年五月廾五日於廬山蓮社一見之次聊加添削畢未再治不可披露之 大乗寺沙門仁空記」, 「新學行要雜事問荅者先師飴述作後葉爲軌範而末弟明空幸稟師迹聊思弘宣勸助役於同志彰文字於印板廼施廬山教肆永傳來際學侶一耳時應永七秊歳次庚辰暮春初五日 幹縁比丘照珍 右筆比丘慧鏡 廬山住持比丘明空敬誌」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺有界7行17字注文双行, 内匡廓: 18.0×11.4cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「幸淳之」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「福壽主盟幸和上人以結般若縁云寔慶安三年小春之晦蓂也」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後印本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「人中分陀利華」, 「安井文庫」(安井息軒), 「紀伊徳川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
