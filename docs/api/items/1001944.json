    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は表紙による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 薩摩国風圡記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉の裏に「此書ハ太田南畝其姪某ニモ寫サセ自モ寫セシ合せて卒業ノ一本ナルヲ外務権少録高麗環カ家ニ所藏ス ... 于時明治五年歳在壬申冬十月念七日外務権大録坂田諸遠」との識語あり (「中原諸遠」との落款朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "内容: 正徳六丙申年薩摩國大隅國日向國諸縣郡領内陰通番所江渡置候書附写, 日向國沃肥領番所關, 正徳六丙申年薩广國大隅國日向國諸縣郡領内津口番所江渡置候書附写, 享保元丙申年薩广國大隅國嶋々番所江渡置候書附写, 正徳六丙申年薩摩國大隅國日向國諸縣郡領内異國舩番所并遠見番所江渡置候書附写, 享保元丙申年薩广國大隅國嶋々番所建置候場所",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉9行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「南畝文庫」(大田南畝), 「坂田文庫」(坂田諸遠), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
