    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書名は表紙による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻頭に「享保九甲辰年二月十八日和州郡山城請取松平紀伊守信峯三万五千石之御軍役雜兵三千二百七十六人行列」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "附圖の付箋に「享保九甲辰年二月/和州郡山城圖并引渡人数付 本多喜十郎家來/取松平紀伊守三万五千石之役高にて請取之騎馬六十騎惣人数二千余」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "書袋に「本多喜十郎旧領 和州郡山城圖并郡山城請取人数行列」, 「享保九甲辰歳閏四月廿一日写之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「坂田文庫」(坂田諸遠),「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
