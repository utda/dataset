    "archiveshub:note": [
        {
            "@value": "大尾の書名: 春秋經傳集解増註",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 増註春秋左氏傳",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 増註左傳",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心下部に「雄風館」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊語に「從文化三年春三月二十八日至同四年三月七日脱稿畢 とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "大尾に「雄風館著書目録 冢田氏塾」(1丁)を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界9行20字注文双行, 内匡廓: 19.6×13.7cm, 白口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷1-4を欠く",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷28の後見返しに「弘化二年正月十九日巳時致堂源大化卒業於江都傳經廬」(墨書),  「嘉永五年臘月十一日夜亥時校讀畢永卿源頼之」(朱書), 「雄風館著書目録」末に「皇和弘化二年乙巳正月廿四日申時前冩畢 時方大風殆欲抜本 弘化三丙午九月二日講終 致堂海保均大化識」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「海保先生自所書録」, 「篁邨島田氏家臧圖書」, 「島田氏雙桂樓収臧」(島田篁村), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
