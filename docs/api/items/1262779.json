    "bibo:annotates": [
        {
            "@value": "題簽の書名: 鶉衣",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "拾遺[序]中の書名: 鶉ころも",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "のどの書名: うつら, 鶉",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "前篇題後の末に「天明五年乙巳師走の下旬 護花関六林識」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "續編の[序]末に「文政未のとしをはり人 たりほ」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界12行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "奥付に「天保十二辛丑年 浪華書林 心齋槗通北久太郎町南 鹽屋忠兵衞/同通本町北 鹽屋弥七 合梓」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「柴分」, 「青洲文庫」",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
