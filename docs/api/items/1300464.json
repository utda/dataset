    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「寛か嘉永酉年に侍醫を命せられしに因りて請録する所なるに同じ子年 ... 寛依て寛の舊録を謄写して再び完璧せしむる所なり 是とし六月十九日記」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末識語に「右合食禁四頁江戸城局内所掲示嘉永年間余籍小島寶素堂夲謄写今集此類合釘為策因聊識于此云森約之養真時慶應丙寅三月廿四日也」(丁4), 「右合食禁幕府城局内所掲官單飲食禁規八頁元是喜多邨栲窗君所記今借或抄夲謄録森約之養真梫遅慶應丙寅三月廿四日也」(丁8)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "10行罫紙を使用",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「森氏」(森約之), 「男爵田中美津男氏寄贈 先代田中芳男男旧藏書 昭和七年」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
