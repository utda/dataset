    "dcterms:description": [
        {
            "@value": "請求記号: HR:61",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "資料解説: 宇田川榛齋はいくつかの西洋解剖書を翻訳しまとめた「遠西医範」を刊行しようとしたが、実現できなかった。「西説醫範提綱釋義」は榛齋の門人諏訪俊により、その抄本として出された。江戸時代の解剖書の中では最も普及した。内容が平易で病理学や疾病の原因まで及んでいる。題簽タイトル「醫範提綱」。見返しタイトル「和蘭内景醫範提綱」附図：「 西説醫範提綱内象銅版図 」。",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "刊年2: 1805",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
