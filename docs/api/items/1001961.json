    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻第8の巻末書名: 續文粹",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "責任表示は『日本古典籍総合目録データベース』による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「嘉永二年己酉六月以中山信名遺本一挍了標中本 知雄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "安政三年丙辰三月十七日以山崎武陵知雄挍夲再挍合」, 「嘉永第二暦季夏念六日以中山信名遺本遂挍合了標中夲 知雄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "安政三年歳次丙辰首夏十一日以沙門真空藏夲挍合標一夲 同」(巻第7), 「嘉永二年己酉六月廿八日以中山信名遺物零本一挍了標中夲 知雄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "安政三年丙辰五月十四日以山崎知雄挍合夲一挍 松凬葊主」(巻第8), 「安政三年丙辰四月廿八日以山崎知雄挍本再挍朱点或首書」(巻第13)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に藤敦宗-藤資光家系表あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉7行17字",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付訓あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「岸本家藏書」, 「朝田家蔵書」(岸本由豆流), 「陽春廬記」(小中村清矩), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
