    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "書名は題簽(墨書)による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 兀菴録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽の書名(墨書): 宋槧兀菴語録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "箱の書名(墨書): 宋版兀菴禪師語録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「你等曽見巨福山長老麼屋裏人荅曰未曽見兵衛云我自去巨福山參見長老即自來建長寺侍者寮説如上夢事了便得見 兀庵和尚在佛殿領衆行道諷經果如夢見一同始信夢事真實見者聞者手舞足蹈 時景用在侍傍同衆親見是事即略記之」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋末に「寶祐六年季夏望日晉陵尤煜」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「小師景用命工鋟板」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界11行20字注文双行, 内匡廓: 19.4×11.8cm, 白口上黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "見返しに「清蔭識」との墨筆識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "帙題簽に「華園隣花傳来」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "箱に「太田道灌所藏本」, 「師者寂於至元十三年中冬龍翔寺因敇謚宗覺禪師」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「徳」, 「令啚慧果」, 「亮印」, 「四釋玄窩」, 「悟庵」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
