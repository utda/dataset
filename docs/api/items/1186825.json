    "archiveshub:note": [
        {
            "@value": "小口書: 左傳",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻之1-2: 魯隠公. 巻之3-4: 魯桓公. 巻之5-7: 魯荘公. 巻之8: 魯閔公. 巻之9-16: 魯僖公. 巻之17-20: 魯文公. 巻之21-25: 魯宣公. 巻之26-31: 魯成公. 巻之32-44: 魯襄公. 巻之45-60: 魯昭公. 巻之61-64: 魯定公. 巻之65-66: 魯哀公",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界10行17字注文双行, 内匡廓: 25.3×17.0cm, 白口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朝鮮刊本(木活字)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朝鮮綴",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「春秋左傳哀下第30」, 「春秋左氏傳序」, 「春秋經傳集解後序」との補抄あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付箋, 挟紙あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆付訓あり",
