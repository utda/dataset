            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「詩仙堂」(石川丈山), 「紀伊國徳川氏圖書記」, 「紀伊徳川 南葵文庫」",
            "is_public": true,
