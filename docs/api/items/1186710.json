    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 近思録集觧",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "「進近思録表」末に「淳祐十二年正月日朝奉郎監登聞鼓院兼景獻府教授臣葉采上表」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「淳祐戊申長至日建安葉采謹序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "牌記に「正徳己卯夏鳳城精舎刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「于時寛文八年歳次戊申五月吉日 吉野屋權兵衛板行」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周単辺無界8行16字注文双行, 内匡廓: 22.0×15.4cm, 白口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠朝鮮中宗14(1519)刊本重刻後印",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記:「館林藏書」, 「益田」, 「紀伊徳川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
