    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "書名は序首による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻冊次表示は版心による",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽による巻冊次表示: 姊川, 三方原, 長篠, 長久手",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序の内題下に「画中塾」との版元瓢箪型朱印あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「享保七年壬寅夏六月甲子退省齋林信智序」, 「天明三年癸夘臘月川﨑整儀書于樸園」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "跋末に「寳永乙酉季秋望日 後學松田定正謹跋」, 「天明甲辰之春 御書物奉行格源和泉」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末刊語に「活版四戦紀聞一百三十部自天明四年甲辰夏五月十九日搨勒於画中園塾中迄冬十一月十五日而成」, 「活版補助 矢部安兵衛孝始/三宅新三郎正章/小林藤五郎好和」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺無界10行18字, 内匡廓: 22.0×13.8cm, 黒口単黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊國徳川氏圖書記」(和歌山藩徳川家), 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
