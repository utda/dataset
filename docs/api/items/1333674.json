{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1333674",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "原奥書末に「使草書而久不及清書雲州嶋根在陣竹窓之閑隙終功畢 永禄九丙寅年八月中旬 盍静翁道三」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書末に「于時天正第九歳舎辛巳中元日 洛澨翠竹菴一渓叟七十五才道三染毫」, 「右卷令四十六丁奥書ナリ」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「大舘徴葊藏夲ナリ」, 「田西桂斎秘藏」, 「織田龍幡智壽」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "付箋に「診切樞要 曲直瀬正琳氏寫夲 大正十二年三月廿七日消畫了」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉10行注文双行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「雙鹿鑑藏」, 「三井家雙鹿閣」, 「聼仌壬戌以後所集舊槧古鈔」, 「聼仌」, 「大正十二年所得古槧」 (三井高堅)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "汚損, 虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
