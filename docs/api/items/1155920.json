    "dcterms:description": [
        {
            "@value": "後付題簽の書名: 藤貞幹自筆古瓦譜",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "序末に「安永丙申立秋日左京藤貞幹識」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "巻末に榲村所蔵「古瓦譜序」を付す",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "識語に「右序文天地二冊ニ収ムル所ノ尾品目次ナリ安永五年ノ序ハ全ク同時ノ作文ト見エ ... 尾品ノ所藏冊ニタタキハ漸次蒐集セシモノナルヘシ」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "拓本(彩色あり)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "折本(図29幅)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "印記: 「盡秩」, 「無佛齋」, 「無佛齋記」, 「藤貞幹印」(藤貞幹), 「萩野氏藏」(萩野由之)",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
