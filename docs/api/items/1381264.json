    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 塵添壒囊抄",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "題簽の書名: 新板塵添壒囊鈔",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "版心の書名: 壒囊鈔",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序に「于世有壒囊抄七巻觀勝寺行譽渉之所撰也又有塵袋十巻不知作者 ... 于時天文元壬辰年二月上旬三日 釋氏某比丘」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「于時文安二乙丑年十二月十日上下本末四帖書功終之者也比興比興 桒門行譽」(卷第11), 「于時文安三年丙寅五月廾五日 終書功畢/觀勝寺 金剛佛子行譽」(卷第20)とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界11行21字, 内匡廓: 21.3×15.6cm, 中黒口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "卷第20の後見返しに「社 載蓮松碧運譽圎智」, 「知諦之」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「来迎寺輪譽」, 「青洲文庫」(渡辺信)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
