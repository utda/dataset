    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "題簽の書名: 更科日記",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "本奥書に「右さら志な日記以古夲書写以屋代弘賢藏夲及扶桒拾葉集挍合畢 檢校保己一」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "奥書に「右一書は屋代弘賢主所藏の夲を以て塙保己一か挍合したるに安田躬弦か挍夲と岸本由豆流か所藏の季鷹縣主加藤千蔭か挍合とを書加へまた古写夲古印夲数夲を以て高田与清か挍合したるをかり得て写したうさるをかつし補いたるなり 文政十三年六月 斎藤彦麿」, 「天保二年七月卄八日以扶桒拾葉集校了 加藤一周」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "冒頭に識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "毎半葉12行注文双行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "頭注, 傍注あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
