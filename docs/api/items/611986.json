    "dcterms:description": [
        {
            "@value": "請求記号: ベルツ資料:Ｊ",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "資料解説: 著者のエルヴィン・フォン・ベルツ（独 1849－1913）は東京医学校（東京大学医学部）のお雇い外国人教師、在職期間は明治9年6月～35年7月。来日当初は生理学の講義を担当、前任者が帰国後に内科学、病理学などを担当し臨床の重要性を説いた。在職は26年間にも渡り、日本の学生への教育指導と患者の診療に力を尽くした。",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "刊年2: 1882-1883",
