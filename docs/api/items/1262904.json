    "bibo:annotates": [
        {
            "@value": "題簽の書名: 西山三籟集",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "[跋]に「攝浪速之住西山昌林曽祖父以来到父昌察三代吟集之發句 ... 享保十九季商書 法眼昌廸」とあり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "刊記に「享保甲寅1734霜月 西山氏蔵版」とあり(「西山氏藏版」との藏版朱印あり)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "上: 春-夏之部. 下: 秋-冬之部",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "毎半葉14行",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "表紙に「聴雨窓」との蔵書票あり",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        },
        {
            "@value": "印記: 「竹冷插架」(角田竹冷)",
            "is_public": true,
            "property_id": 57,
            "property_label": "annotates",
            "type": "literal"
        }
