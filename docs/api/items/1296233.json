    "dcterms:description": [
        {
            "@value": "写本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書名及び巻冊次は題簽による",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "跋末に「松夲生名ハ百藏東京帝國大學ノ使丁タリ職ヲ山上會議所ニ奉スルコト四十有餘年 ... 頃来マタ諸賢ノ揮毫ヲ乞上名ケテ騁懐帖トイフ ... 帖成リテ予ニ其由来ヲ記セシコトヲ求ム乃チ之ヲ録シテ以テ跋後トス 昭和二年三月 辻善之助識」とあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "折本",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "書画帖",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "彩色あり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "名録2冊(大和綴)を付す",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        },
        {
            "@value": "落款朱印: 「長成」(坪井九馬三), 「圭卿」(市村瓚次郎), 「簣山」(鹽谷時敏), 「維亭」(塚本靖), 「土肥慶藏」, 「忠太」(伊東忠太), 「萬」(和田万吉), 「芳溪」(呉秀三), 「前田慧雲」, 「大澤謙二」, 「南條文雄」, 「有坂氏」(有坂鉊藏), 「博」, 「石亭」(林博太郎), 「長與又郎」, 「宇野哲人」, ほかあり",
            "is_public": true,
            "property_id": 4,
            "property_label": "Description",
            "type": "literal"
        }
    ],
