            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "目首の書名: 重刋醫方大成論",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序中の書名: 醫方大成, 大成",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "表紙の書名(墨書): 大成論",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "[序]題下に「宗文書堂新刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「文江孫氏集諸方取功要者名以類編名爲大成各類之首又取三因及嚴氏諸家之説合而爲論 ... 旹辛酉至治初元文江王元福序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「慶長十六年辛亥季春良日梅壽重刋」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺無界10行18字, 内匡廓: 17.4×15.4cm, 中黒口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "古活字本",
            "is_public": true,
