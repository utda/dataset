    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "小口書: 口遊",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序末に「于時天禄元年冬十二月二十七日僕夫源為憲序」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「于時弘長三年二月五日於山田亭愚息行文書写之少々加愚筆畢」, 「寛政十一年己未仲冬以大湏文庫古謄夲摸冩令平安書賈某上木傳不朽云 大館高門」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "刊記に「文化四年丁夘仲彂兌 皇都書肆 佐々木摠四郎 風月荘左衛門」とあり(「竹苞」との版元朱印あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周無辺無界7-10行",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "模刻本",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
