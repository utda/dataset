{
    "@context": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api-context",
    "@id": "https://iiif.dl.itc.u-tokyo.ac.jp/repo/api/items/1186908",
    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序首の書名: 古本大學",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序文に「吾懼學之目遠於至善也去分章而復舊本傍爲之釋以引其義」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "四周双辺有界7行13字(「大學問」は10行21字), 内匡廓: 21.3×16.0cm, 白口双花魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "訓点付",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉裏に「大學古本旁釋序 ... 余今重訂之序取文録所収者旁釈極為簡易亦僭補数條除去李夲附録依倣鄒本以大學問附焉庶箴於讀古本者或有所裨益爾 文政十二年己丑嘉平月晦 江都佐藤坦識」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "巻末に「大學問跋 ... 安成鄒守益跋」, 「大學旁釋跋 ... 天保甲午嵗夏六月 安藝後学吉村晋謹跋」との墨書を付す",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後見返しに「精義艸廬藏 弘化紀元十有二月看過僅記」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「紀伊恴川 南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
    ],
