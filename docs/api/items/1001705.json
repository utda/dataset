    "@type": "o:Item",
    "archiveshub:note": [
        {
            "@value": "序目, 後序の書名: 朱子語類大全",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "姓氏の書名: 朱子語録",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後序版心の書名: 語類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "小口書: 朱語類",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序目末に「咸淳庚午正月辛亥靖徳再書」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "後序末に「此編江西憲副三山陳公文耀翻刻以幸學者 ... 成化癸巳十月甲子賜進士出身翰林院編脩南昌張元禎序」, 「是編者乃導江黎靖徳合三録二類而名爲大全 ... 成化辛卯來佐憲江右偶於豫章胡頥菴家訪得印本缺卷二十餘無可補者越二年巡湖東復得全本於於呉康齋家雖殘缺補以胡家本斯無遺矣... 成化九年癸巳十一月望賜進士江西按察副使三山陳煒謹書」とあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "扉裏に「朱子語類大全三百十六巻廿冊 巻中硃圏及句讀共係于先師林文敏公手澤其掲校訂于上層者硃墨共係于鵞峰先生手録」との識語あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "左右双辺有界14行24字注文双行, 内匡廓: 20.0×14.8cm, 白口三黒魚尾",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "拠成化9(1473)陳煒覆咸淳6(1270)黎靖徳郡齋刊本重刻",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱点, 朱引あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "朱墨筆書き入れあり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "序目冒頭の上欄に「錢牧齋舊藏」との墨書あり",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "印記: 「牧齋藏書」(銭謙益), 「静修齋」, 「讀耕齋之家藏」(林読耕斎), 「青桺館文庫」(青柳文蔵), 「敬甫」, 「島田重禮」, 「島田氏雙桂樓収臧」(島田篁村), 「南葵文庫」",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        },
        {
            "@value": "虫損あり (裏打ち補修あり)",
            "is_public": true,
            "property_id": 332,
            "property_label": "Note",
            "type": "literal"
        }
