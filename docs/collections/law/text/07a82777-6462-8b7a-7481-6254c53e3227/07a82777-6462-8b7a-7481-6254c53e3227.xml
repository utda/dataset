  <text>
        <body>
            <p>
                <hi rend="color(#000000)">定</hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">り志たん宗門者累年</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">制禁たり自然不審成</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">有之ハ申出へし御ほうひとして</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">はてれんの訴人 銀五百枚<lb/></hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">るまんの訴人 銀三百枚<lb/></hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">立かへり者の訴人 同断<lb/></hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">同宿并宗門の訴人 銀百枚</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">之通可被</hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">同宿宗家の</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">といふとも訴人申出</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">銀五百枚可被下加之至</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">によりあらハるるにおいてハ</hi>
            </p>
            <p>
                <hi rend="color(#000000)">□</hi>
                <hi rend="color(#000000)">其？の名主并五人組一類共に可</hi>
            </p>
            <p>
                <hi rend="color(#000000)">被処？厳科者也仍正一件</hi>
            </p>
            <p>
                <hi rend="color(#000000)">天和二年五月日<lb/>
                </hi>
                <hi rend="color(#000000)">奉行</hi>
            </p>
        </body>
